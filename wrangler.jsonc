{
  "name": "rosetta-quantum",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  // run_worker_first: por defecto, si existe el archivo estatico, Cloudflare lo sirve
  // SIN invocar el Worker. Los posts de D1 funcionan igual (no hay archivo, cae al
  // Worker), pero el indice y los feeds SI existen como archivo, asi que sin esta
  // lista el codigo que inyecta las entradas de D1 no llega a ejecutarse nunca.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // /og/* entra por una razon distinta a las demas y conviene no "arreglarla": un GET
    // a una tarjeta inexistente ya caia al Worker solo, pero un HEAD NO —medido en
    // local el 26-oct: GET /og/<id>.png daba 200 y HEAD daba 404, porque la capa de
    // assets responde el HEAD sin invocar al Worker— y varios rastreadores sociales
    // piden HEAD antes de bajar la imagen. Meterla aqui es seguro porque el Worker
    // termina en `env.ASSETS.fetch(request)`: las SEIS tarjetas fijas de public/og/
    // siguen ganando por existir (comprobado byte a byte en local).
    //
    // /clases y /es/clases SI existen como archivo construido, asi que sin esta
    // lista Cloudflare los sirve tal cual y el codigo que inyecta el archivador
    // desde D1 no llega a ejecutarse nunca. Misma trampa que costo dos deploys
    // con el indice de la Biblioteca.
    "run_worker_first": ["/blog", "/blog/*", "/es/blog", "/es/blog/", "/llms.txt", "/rss.xml", "/sitemap-0.xml", "/v1", "/v1/*", "/mcp", "/og/*"]
  },
  // La tarjeta social por nota (/og/<id>.png) se rasteriza DENTRO del Worker con
  // resvg-wasm, porque aqui no hay Chrome y las notas se publican por INSERT sin
  // rebuild. Tres tipos de modulo no-JS entran al bundle por eso:
  //   Data  -> las dos TTF. resvg en un Worker NO tiene fuentes del sistema: un texto
  //            sin su familia cargada no da error, sale VACIO (medido). Van embebidas y
  //            no se bajan en caliente para que la tarjeta no dependa de una tercera
  //            parte en el momento en que LinkedIn la pide.
  //   Text  -> global.css, para leer los tokens de marca de SU UNICA fuente en vez de
  //            copiar los hex al codigo de la tarjeta; y rosetta-mark.svg, el mismo
  //            archivo que sirve el sitio, para no duplicar el path del logotipo.
  // El .wasm no necesita regla: CompiledWasm es el tipo por defecto de **/*.wasm.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/global.css", "**/rosetta-mark.svg"], "fallthrough": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "rosettaq-ledger", "database_id": "f0919403-5bd0-4842-a1d3-0954fdd47633" }
  ],
  // Envio nativo de correo (Cloudflare Email Routing), sin API de terceros ni secreto
  // nuevo. Confirmado por DNS PUBLICO, sin token: el MX de rosettaquantum.com apunta a
  // *.mx.cloudflare.net y el SPF incluye _spf.mx.cloudflare.net, o sea Email Routing ya
  // esta activo en la zona. `destination_address` tiene que ser una direccion YA
  // verificada en el panel de Email Routing — hello@ ya recibe correo real (memoria del
  // proyecto: "hello@ esta verificado, la regla existe"), asi que se asume verificada;
  // si no lo estuviera, el proximo deploy lo va a decir.
  "send_email": [
    { "name": "MAILER", "destination_address": "hello@rosettaquantum.com" }
  ]
  ,
  // ── Entorno de PREVIEW (commit 0 del spec de migracion v5.0) ────────────────
  // Existe porque hoy la unica ruta a un entorno vivo es empujar a main, que ES
  // produccion. El modo de fallo dominante de este repo es silencioso —la lista
  // run_worker_first, los cascarones del blog, el orden del CSS— y las tres solo
  // se ven sirviendo la pagina de verdad.
  //
  // MISMA D1 y MISMO MAILER que produccion, a proposito: un preview contra otra
  // base no prueba lo que tiene que probar (los posts de D1, las cifras de
  // /v1/state). La contrapartida es real y hay que tenerla presente: lo que este
  // Worker ESCRIBA cae en la base de produccion. Hoy escribe leads, qready_leads
  // y api_usage — nada del ledger.
  //
  // Un entorno con nombre NO hereda los bindings del nivel superior: hay que
  // repetirlos. Solo main y compatibility_date se heredan.
  "env": {
    "preview": {
      "name": "rosetta-quantum-preview",
      "workers_dev": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "run_worker_first": ["/blog", "/blog/*", "/es/blog", "/es/blog/", "/llms.txt", "/rss.xml", "/sitemap-0.xml", "/v1", "/v1/*", "/mcp", "/og/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "rosettaq-ledger", "database_id": "f0919403-5bd0-4842-a1d3-0954fdd47633" }
      ],
      "send_email": [
        { "name": "MAILER", "destination_address": "hello@rosettaquantum.com" }
      ]
    }
  }
}
