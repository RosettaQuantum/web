---
/**
 * Layout de las paginas del rebuild (maqueta v20).
 *
 * Existe para que las trece paginas de los commits 7-9 no repitan trece veces la misma
 * decision. Cada repeticion es una oportunidad de que una pagina se quede con el chrome
 * viejo, con la tipografia equivocada o con el pie duplicado — que es exactamente lo que
 * ya paso con la home cuando esas decisiones estaban sueltas en el archivo de la pagina.
 *
 * Lo que fija: barra v2, pie v2, tipografias de marca, hoja de la maqueta, y apagar el
 * chrome viejo de BaseLayout. Lo vigilan T-estructura y T-fuentes en cada deploy.
 */
import BaseLayout from './BaseLayout.astro';
import { sinComentarios } from '../lib/css-sin-comentarios.js';
import NavV2 from '../components/NavV2.astro';
import PieV2 from '../components/PieV2.astro';
import marca from '../styles/pages/home.css?raw';
import navCss from '../styles/componentes/nav.css?raw';
/* `marca-gana.css` se retiro el 10-sep (bloque 2, paso 0). Existia porque global.css
   traia la identidad retirada a TODAS las paginas y habia que taparla; ahora esa hoja
   la piden solo las paginas que la conservan, asi que no hay nada que tapar. */

const { title, description, lang = 'en', altUrl = '/es/', ruta = '/', pageCss = '', scripts = [], noindex = false } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  lang={lang}
  altUrl={altUrl}
  pageCss={navCss + "\n" + marca + "\n" + pageCss}
  scripts={scripts}
  noindex={noindex}
  nav={false}
  pie={false}
  fuentes="marca"
>
  {/* `alt` NO es opcional: sin el, NavV2 cae a poner o quitar el prefijo /es, y los
      slugs del sitio estan TRADUCIDOS. Asi, el conmutador de idioma de /pilots apuntaba
      a /es/pilots —que no existe— en 19 de las 27 paginas. El destino correcto estaba
      en este mismo archivo, en `altUrl`, alimentando el hreflang del <head>: la pagina
      declaraba /es/pilotos a los buscadores y le ofrecia /es/pilots a la persona. */}
  <NavV2 lang={lang} ruta={ruta} alt={altUrl} />
  <slot />
  <PieV2 lang={lang} />
</BaseLayout>
