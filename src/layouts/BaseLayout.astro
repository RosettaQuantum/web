---
import '../styles/global.css';
/* La identidad retirada NO viaja en todas las paginas: la piden solo las que la
   conservan por decision (`fuentes="vieja"`). Ver el encabezado de legado.css. */
import legado from '../styles/legado.css?raw';
import { sinComentarios } from '../lib/css-sin-comentarios.js';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import { abs } from '../lib/urls.js';
// `nav` por omision TRUE: las 38 paginas que aun usan la barra vieja no cambian.
// La home v20 pasa nav={false} y monta NavV2, que es la barra nueva con rutas reales.
// Se agrega una opcion en vez de reemplazar Nav.astro de golpe: cambiarlo para todas
// pondria la barra clara sobre las paginas viejas, que siguen en el diseño oscuro.
// `fuentes`: que familias PIDE el documento. Por omision, las tres del diseño viejo,
// para que las 38 paginas que siguen en el no cambien. Las paginas del rebuild pasan
// fuentes="marca" y piden las del brand system.
//
// POR QUE ES UN PROP Y NO UN CAMBIO GLOBAL: la home v20 declara --serif:'Newsreader' y
// --sans:'IBM Plex Sans' en global.css, pero este layout solo pedia Marcellus e
// Instrument Sans. El navegador no avisa: cae al sustituto (Georgia, system-ui) y la
// pagina se ve BIEN, solo que en otra tipografia. Medido en el preview el 2-sep:
// document.fonts traia [IBM Plex Mono, Instrument Sans, Marcellus] y el ancho de un
// texto en 'Newsreader' era identico al del serif generico. Lo vigila T-fuentes.
const FUENTES = {
  vieja: 'https://fonts.googleapis.com/css2?family=Marcellus&family=Instrument+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap',
  marca: 'https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap',
};
// `pie`: mismo caso que `nav`. La maqueta v20 trae su propio <footer> dentro del
// cuerpo, asi que la home servia DOS: el de la marca y el oscuro de Footer.astro.
// Se vio contando <footer en el HTML servido, no mirando la pagina — el segundo pie
// queda al final del scroll, donde nadie llega revisando.
// `noindex`: la pagina se sirve igual, pero se le pide a los buscadores que no la
// indexen. Decision de Nicholas del 8-sep para /q-ready: la pagina QUEDA VIVA —hay un
// flujo de leads que no se toca— y sale del indice. Fuera del sitemap ya estaba; sin
// esta etiqueta un enlace desde afuera la mete al indice igual.
const { title, description, lang='en', altUrl='/es/', pageCss='', scripts=[], nav=true, pie=true, fuentes='vieja', noindex=false } = Astro.props;
const hrefFuentes = FUENTES[fuentes] || FUENTES.vieja;
const altLang = lang==='en' ? 'es' : 'en';
// absolutas y con barra final: una hreflang relativa es válida pero frágil, y
// sin canonical /ruta y /ruta/ son dos páginas distintas para Google.
const canonical = abs(Astro.url.pathname);
const altHref = abs(altUrl);
const xDefault = lang === 'en' ? canonical : altHref;
// Marca de version. Existe para que un chequeo pueda saber si el edge ya sirve
// ESTE build o todavia el anterior. Sin ella, esperar a que una ruta responda 200
// no distingue lo viejo de lo nuevo — la pagina responde 200 en los dos casos, y
// el CI cayo por eso mas de una vez.
const build = (process.env.GITHUB_SHA || process.env.RQ_BUILD || 'local').slice(0, 12);

/* B1.4 · METADATOS SOCIALES. Medido el 10-sep en produccion: CERO coincidencias de
   `og:` y `twitter:` en el HTML servido. Compartir cualquier pagina del sitio en
   Slack, LinkedIn o X mostraba una URL pelada — para un sitio cuyo canal es que otros
   lo citen, es el peor lugar donde ahorrar catorce lineas.

   `ogImagen` se elige por la primera coincidencia de ruta; el resto cae al general.
   Las imagenes las genera scripts/build-og.mjs a 1200x630 desde el mismo build. */
const OG = [
  [/^\/(es\/)?(biblioteca|library)/, 'library'],
  [/^\/(es\/)?ledger/,                'ledger'],
  [/^\/(es\/)?(servicios|services)/,  'services'],
  [/^\/(es\/)?(pilotos|pilots)/,      'cases'],
];
const rutaOg = Astro.url.pathname;
const ogImagen = abs('/og/' + ((OG.find(([re]) => re.test(rutaOg)) || [null, 'default'])[1]) + '.png');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="rq-build" content={build} />
  {noindex && <meta name="robots" content="noindex" />}
  {/* El sitio NO tenia favicon: /favicon.ico y /favicon.svg daban 404 en produccion y en
      el preview, y este layout no declaraba ninguno. Un icono ausente no rompe nada y se
      nota en cada pestaña del navegador. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Rosetta Quantum" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImagen} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImagen} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  <link rel="alternate" hreflang={altLang} href={altHref} />
  <link rel="alternate" hreflang="x-default" href={xDefault} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  {/* B1.6 · faltaba este, y es el que importa: googleapis sirve la hoja (2 KB),
      gstatic sirve los 132 KB de las fuentes. Sin el preconnect, con display=swap
      el H1 se pinta en sans y salta a serif a la vista del lector. */}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={hrefFuentes} rel="stylesheet" />
  {fuentes === 'vieja' && <style is:global set:html={sinComentarios(legado)}></style>}
  {pageCss && <style is:global set:html={sinComentarios(pageCss)}></style>}
</head>
<body>
  {nav && <Nav lang={lang} altUrl={altUrl} />}
  <slot />
  {pie && <Footer lang={lang} />}
  {scripts.map((s) => <script is:inline src={s}></script>)}
  <LeadModal lang={lang} />
</body>
</html>
