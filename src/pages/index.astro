---
/**
 * Home v20 — commits 6 y 6-fixes.
 *
 * El contenido se importa como ARCHIVO (?raw), no se reescribe: copiar a ojo una maqueta
 * congelada es como se pierde una maqueta aprobada (§6 de la casa).
 *
 * Todo el chrome (barra, pie, tipografias, hoja de la maqueta y las reglas que tienen que
 * ganarle a global.css) lo pone MarcaLayout. Estaba suelto aqui y por eso esta pagina
 * salio con dos pies, con la tipografia del diseño viejo y 80 px mas ancha.
 *
 * Lo vivo entra por islas contra /v1/* (decision D1): la home sigue siendo un archivo
 * estatico y NO entra a run_worker_first.
 */
import MarcaLayout from '../layouts/MarcaLayout.astro';
import content from '../content_html/home.en.html?raw';
---
<MarcaLayout
  title="Rosetta Quantum — Quantum, independently measured"
  description="Pre-registered, sealed, published win or lose — so you can build or invest on evidence."
  lang="en" altUrl="/es/" ruta="/"
  scripts={["/js/home.js", "/js/home-islas.js"]}
>
  <Fragment set:html={content} />
</MarcaLayout>
