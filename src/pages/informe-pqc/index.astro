---
import { banda } from '../../lib/qex.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import css from '../../styles/pages/informe-pqc.css?raw';

// Ediciones: un JSON por mes. La más reciente manda; la anterior alimenta las variaciones.
const mods = import.meta.glob('../../data/informe-pqc/*.json', { eager: true });
// El nombre del archivo y el campo `edicion` deben decir lo mismo. Si no coinciden,
// el build falla: no hay forma de saber cuál de los dos miente, y elegir uno en silencio
// mueve el defecto en vez de arreglarlo.
const ediciones = Object.entries(mods).map(([p, m]: any) => {
  const archivo = p.split('/').pop()!;
  const slug = archivo.replace(/\.json$/, '');
  const d = m.default ?? m;
  if (!/^\d{4}-\d{2}$/.test(slug))
    throw new Error(`informe-pqc: el archivo "${archivo}" no se llama AAAA-MM.json`);
  if (!/^\d{4}-\d{2}$/.test(d?.edicion ?? ''))
    throw new Error(`informe-pqc: "${archivo}" no trae campo \`edicion\` con formato AAAA-MM`);
  if (d.edicion !== slug)
    throw new Error(`informe-pqc: "${archivo}" declara edicion="${d.edicion}". El nombre del archivo y el campo deben coincidir.`);
  return { slug, archivo, d };
}).sort((a, b) => b.slug.localeCompare(a.slug));

if (!ediciones.length) throw new Error('informe-pqc: no hay ninguna edición en src/data/informe-pqc/');

// La cadena de comparación tiene que ser consistente: si una edición dice de cuál viene,
// esa tiene que ser la anterior real. Un `anterior` equivocado compara contra el mes que no es.
for (let i = 0; i < ediciones.length - 1; i++) {
  const esperada = ediciones[i + 1].slug;
  const declarada = ediciones[i].d.anterior;
  if (declarada != null && declarada !== esperada)
    throw new Error(`informe-pqc: ${ediciones[i].slug} declara anterior="${declarada}" pero la anterior real es ${esperada}.`);
}

const { d } = ediciones[0];
const prev = ediciones[1]?.d ?? null;

const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const [yy, mm] = d.edicion.split('-').map(Number);
const mesLargo = `${MESES[mm-1]} de ${yy}`;

/** Variación contra la edición anterior. Sin anterior devuelve la marca de línea base. */
/** Color según si subir es bueno o malo para ESA métrica. `polaridad:'mayor_mejor'`
 *  invierte el semáforo. Sin declararla, se asume que subir es malo. */
function pintar(dif: number, polaridad?: string) {
  if (polaridad === 'neutra') return 'flat';   // moverse no es mejor ni peor: sin semáforo
  const mejora = polaridad === 'mayor_mejor' ? dif > 0 : dif < 0;
  return mejora ? 'down' : 'up';   // .down = verde (mejora) · .up = rojo (empeora)
}
function delta(id: string, valor: number) {
  if (!prev) return { cls: 'new', txt: 'línea base' };
  const ant = prev.titulares?.find((t: any) => t.id === id);
  if (!ant) return { cls: 'new', txt: 'nuevo' };
  const dif = +(valor - ant.v).toFixed(1);
  if (dif === 0) return { cls: 'flat', txt: 'sin cambio' };
  return { cls: pintar(dif, ant.polaridad), txt: `${dif > 0 ? '+' : ''}${dif}${ant.u ?? ''}` };
}
function deltaVert(id: string, ratio: number) {
  if (!prev) return null;
  const ant = prev.verticales?.find((v: any) => v.id === id);
  if (!ant) return { cls: 'new', txt: 'nuevo' };
  const dif = ratio - ant.ratio;
  if (dif === 0) return { cls: 'flat', txt: '=' };
  // adopción de híbrido: subir es mejor
  return { cls: pintar(dif, 'mayor_mejor'), txt: `${dif > 0 ? '+' : ''}${dif}` };
}

const nf = (n: number) => n.toLocaleString('es-CL');
const cdnPct = (o: any) => o.pct;

const SECCIONES = [
  ['panel','Panel de exposición'], ['ejecutivo','Resumen para directorio'],
  ['indice','El índice QEX'], ['medicion','La medición del mes'], ['trampa','La trampa del CDN'],
  ['ruta','Ruta crítica por proveedor'], ['costo','El costo de esperar'],
  ['entregable','Así se ve su informe'], ['contexto','Por qué existe el problema'],
  ['reloj','Dónde está la máquina y cuándo llega'], ['glosario','Glosario'],
  ['legal','Metodología, límites y aviso legal'],
];
---
<BaseLayout
  title={`${d.titulo} — Informe ${mesLargo} · Rosetta Quantum`}
  description={`${d.subtitulo}. Edición ${d.numero}, ${mesLargo}. Medición técnica sobre endpoints reales, no encuesta.`}
  lang="es" pageCss={css}>

<div class="informe-doc">
<div class="informe">

  <header class="mast">
    <div class="brandrow">
      <svg class="slabmark" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="12.5" y="3.5" width="15" height="27" rx="7.5" fill="none" stroke="#9A7228" stroke-width="1.8"/>
        <line x1="13.5" y1="35" x2="26.5" y2="35" stroke="#9A7228" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="20" cy="12.5" r="3" fill="none" stroke="#3D372F" stroke-width="1.5"/>
        <circle cx="20" cy="21.5" r="3" fill="#1E7A6E"/>
      </svg>
      <span class="brandname">Rosetta Quantum</span>
    </div>

    <div class="edicion">
      <span class="num">Edición {String(d.numero).padStart(2,'0')}</span>
      <span>{mesLargo}</span>
      <span>Medición {d.ventana.desde} → {d.ventana.hasta}</span>
      <span>{d.muestra.organizaciones} organizaciones · {d.muestra.verticales} verticales</span>
      <span>{prev ? `Compara contra edición ${String(prev.numero).padStart(2,'0')}` : 'Primera edición · línea base'}</span>
    </div>

    <h1>{d.titulo}</h1>
    <p class="standfirst">{d.subtitulo}</p>
  </header>

  {d.SIMULADO && (
    <div class="draft" style="border-width:2px;background:#F8E6E1">
      <strong>⚠ EDICIÓN CON DATOS SIMULADOS — NO PUBLICAR.</strong> {d.SIMULADO} Existe solo para verificar que la comparación mes a mes funciona.
    </div>
  )}
  <div class="draft">
    <strong>Borrador de trabajo.</strong> Pendiente antes de publicar: revisión legal de los seis puntos marcados en la sección 11, y aviso previo a las organizaciones con hallazgos.
  </div>

  <div class="measure" style="margin:32px 0 8px">
    <p class="lede">
      <strong>Este es un informe mensual, no un estudio puntual.</strong> Cada edición mide la misma
      muestra de {d.muestra.organizaciones} organizaciones con el mismo método y publica el mismo índice,
      para que las cifras puedan leerse como una serie. {prev
        ? `Las variaciones respecto de la edición anterior aparecen junto a cada métrica y en cada barra.`
        : `Esta primera edición fija la línea base: desde la próxima, cada métrica llevará su variación mensual y podrá verse quién se movió y hacia dónde.`}
    </p>
  </div>

  <nav class="toc" id="contenido" aria-label="Contenido">
    <h2>Contenido de esta edición</h2>
    <ol>
      <li><a href="#panel"><span class="tl">Panel de exposición · lectura de 30 segundos</span></a></li>
      <li><a href="#ejecutivo"><span class="tl">Resumen para directorio · dos minutos</span></a></li>
      <li><a href="#relojes"><span class="tl">Los cuatro relojes</span></a></li>
      <li><a href="#indice"><span class="tl">El índice</span></a></li>
      <li><a href="#medicion"><span class="tl">La medición</span></a></li>
      <li><a href="#trampa"><span class="tl">La trampa</span></a></li>
      <li><a href="#ruta"><span class="tl">Lo que sí define su plazo</span></a></li>
      <li><a href="#costo"><span class="tl">El costo de esperar</span></a></li>
      <li><a href="#entregable"><span class="tl">Qué se puede saber de su organización</span></a></li>
      <li><a href="#contexto"><span class="tl">Por qué existe el problema</span></a></li>
      <li><a href="#reloj"><span class="tl">Dónde está la máquina y cuándo llega</span></a></li>
      <li><a href="#glosario"><span class="tl">Glosario</span></a></li>
      <li><a href="#legal"><span class="tl">Metodología, límites y aviso legal</span></a></li>
    </ol>
  </nav>

  <!-- CONTEXTO GLOBAL -->
  <div class="chart" style="margin:34px 0 6px">
    <div class="chart-h">
      <p class="chart-t">Dónde está el mundo, y dónde está Chile</p>
      <p class="chart-s">Todas las cifras provienen de mediciones técnicas sobre endpoints, no de encuestas.</p>
    </div>
    <div class="chart-b"><div class="tw">
      <table>
        <thead><tr><th>Qué se mide</th><th class="num">Mundo</th><th class="num">Chile</th><th>De dónde sale la referencia</th></tr></thead>
        <tbody>
          <tr><td>Endpoints que negocian intercambio híbrido</td>
            <td class="num">{d.referencia_global.hibrido_global}%</td>
            <td class="num"><strong>{d.referencia_global.hibrido_chile}%</strong></td>
            <td>{nf(d.referencia_global.dominios_medidos)} dominios · {d.referencia_global.fuente}</td></tr>
          <tr><td>Servidores configurados por su dueño con híbrido</td>
            <td class="num">0%</td><td class="num">—</td>
            <td>8.443 configuraciones Nginx reales · arXiv:2605.17955</td></tr>
          <tr><td>Certificados post-cuánticos en producción</td>
            <td class="num">0%</td><td class="num">0%</td>
            <td>Todas las mediciones publicadas coinciden</td></tr>
          <tr><td>Países con mandato o guía técnica con plazos</td>
            <td class="num">12+</td><td class="num"><strong>0</strong></td>
            <td>Revisión propia de instrumentos regulatorios</td></tr>
        </tbody>
      </table>
    </div>
    <p class="src">Chile está cuatro puntos por encima del promedio mundial en la métrica visible — y ese promedio deja la mitad de la infraestructura sin proteger. La autenticación sigue íntegramente clásica en todo el mundo.</p>
    </div>
  </div>

  <div class="measure" style="margin-bottom:8px">
    <p>Tres cosas conviene tener claras antes de mirar cualquier número de este informe. <strong>La primera</strong> es que Chile no está atrasado respecto del mundo: está levemente por delante, y eso no es una buena noticia sino una medida de lo bajo que está el promedio. <strong>La segunda</strong> es que la única métrica donde el mundo avanza —el intercambio de claves en el borde— es también la que un proveedor de infraestructura activa por contrato, sin que la organización decida nada. <strong>Y la tercera</strong> es que la autenticación, que es la mitad del problema, está en cero en todas partes.</p>
  </div>

  <!-- 01 · PANEL -->
  <section id="panel">
    <div class="sechead">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 9v11"/></svg>
      <span class="snum">01 · Panel de exposición · lectura de 30 segundos</span>
    </div>

    <div class="panel">
      <div class="panel-h">
        <h3>Superficie criptográfica pública — gran empresa chilena</h3>
        <span class="meta">n = {d.muestra.organizaciones} · {d.muestra.sondeadas} sondeadas</span>
      </div>
      <div class="tiles">
        {d.titulares.map((t: any) => {
          const dl = delta(t.id, t.v);
          const sev = t.sev === 'asterisco' ? '' : t.sev === 'info' ? '' : t.sev;
          return (
            <div class={`tile ${sev}`}>
              <span class="k">{t.k}{t.sev === 'asterisco' ? ' *' : ''}</span>
              <span class="v">{nf(t.v)}{t.u}</span>
              <span class="sub">
                <span class={`delta ${dl.cls}`}>{dl.txt}</span>{' '}{t.sub}
              </span>
            </div>
          );
        })}
      </div>
    </div>
    <p class="src">* Métrica que un cambio de proveedor de CDN pone en verde sin modificar la exposición real. Ver sección 04.</p>

    <div class="chart">
      <div class="chart-h">
        <p class="chart-t">Cuánta superficie pública tiene una gran empresa chilena</p>
        <p class="chart-s">Nombres de host en registros públicos de certificados. n = {d.muestra.con_indice}.</p>
      </div>
      <div class="chart-b">
        <div class="bars">
          {d.superficie.map((s: any) => (
            <div class="bar-row">
              <span class="bar-lab">{s.rango}</span>
              <div class="bar-track"><div class={`bar-fill ${s.pct>=18?'lo':s.pct>=30?'mid':''}`} style={`width:${Math.round(s.pct/35*100)}%`}></div></div>
              <span class="bar-val">{s.n} · {s.pct}%</span>
            </div>
          ))}
        </div>
        <p class="src">El 58% tiene más de 30 nombres de host públicos. El 82% tiene subdominios de tercer o cuarto nivel.</p>
      </div>
    </div>
  </section>

  <!-- 02 · EJECUTIVO -->
  <section id="ejecutivo">
    <div class="sechead">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h7"/></svg>
      <span class="snum">02 · Resumen para directorio · dos minutos</span>
    </div>
    <h2>Lo que un directorio necesita saber</h2>
    <div class="measure">
      <p class="lede">Toda la criptografía que hoy protege las transacciones, los contratos y los registros de su organización quedará obsoleta dentro del horizonte de vida útil de esos mismos datos. No es una hipótesis: es un calendario que otros ya fijaron.</p>
    </div>

    <div class="term">
      <dl>
        <dt>El riesgo, en una línea</dt>
        <dd>Un adversario puede capturar tráfico cifrado <strong>hoy</strong> y descifrarlo cuando exista la máquina. Todo dato que deba seguir siendo secreto más allá de ~2035 está, en términos de riesgo, expuesto desde el momento en que se transmite.</dd>
        <dt>Por qué ahora y no en cinco años</dt>
        <dd>Una migración toma años y depende de proveedores que aún no se comprometen. El margen se calcula <strong>restando</strong>: vida útil del dato, más tiempo de migración, contra el horizonte de la amenaza.</dd>
      </dl>
    </div>

    <div class="measure">
      <h3>El número, y qué significa</h3>
      <p>La mediana nacional del <strong>{d.indice.nombre}</strong> es <strong>{d.indice.mediana} sobre {d.indice.tope}</strong>, con todas las organizaciones medidas entre {d.indice.min} y {d.indice.max}. Ese apiñamiento es el dato más importante del informe: <strong>no hay líderes.</strong> El {d.indice.certificados_detalle.pct_parametros_deprecados}% firma con parámetros que quedan deprecados después de 2030, y esa capa no la resuelve ningún proveedor.</p>

      <h3>Tres hechos medidos, no opinados</h3>
      <ul>
        <li><strong>Casi la mitad de las grandes organizaciones chilenas no tiene protección post-cuántica en su infraestructura pública.</strong> Y de las que sí la tienen, prácticamente todas la obtuvieron como efecto secundario de su contrato de CDN.</li>
        <li><strong>El 60% tiene ambientes de prueba o infraestructura sensible respondiendo en internet</strong>, y el 96% no tiene canal donde alguien pueda reportárselo.</li>
        <li><strong>Ningún proveedor de core bancario o switch de pagos tiene soporte post-cuántico comprometido públicamente.</strong> El plazo real lo define un tercero que todavía no ha dicho cuándo.</li>
      </ul>

      <h3>Qué decidir</h3>
      <ul>
        <li><strong>Nombrar un responsable</strong> de agilidad criptográfica. Hoy nadie tiene el problema asignado.</li>
        <li><strong>Levantar el inventario</strong> de dónde vive la criptografía. Primer requisito de todos los marcos internacionales.</li>
        <li><strong>Preguntarle a los proveedores críticos</strong> por su fecha comprometida. Esa respuesta define el plazo mejor que cualquier pronóstico.</li>
      </ul>
    </div>
  </section>

  <!-- 04 · EL INDICE -->
  <!-- 03 · LOS CUATRO RELOJES -->
  <section id="relojes">
    <div class="sechead">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
      <span class="snum">03 · Los cuatro relojes</span>
    </div>
    <h2>Nadie lo va a multar este año. Igual va tarde.</h2>
    <div class="measure">
      <p class="lede">La objeción razonable a todo este informe es «no hay ninguna norma que me
      obligue». Es cierta, y no cambia nada. Hay cuatro relojes corriendo y sólo uno de ellos es
      el del regulador — que además es el que va más lento.</p>
    </div>

    {d.relojes.map((r: any, i: number) => (
      <div class="panel">
        <div class="panel-h">
          <h3>{i + 1} · {r.n}</h3>
          <span class={`chip ${r.sev}`}>{r.sub}</span>
        </div>
        <div class="tile">
          <p style="margin:0">{r.cuerpo}</p>
          {r.pie && <p class="src" style="margin:.7em 0 0">{r.pie}</p>}
        </div>
      </div>
    ))}

    <h3>Y en Chile, con todas sus letras</h3>
    <div class="measure">
      <p><strong>{d.chile.afirmacion}</strong> {d.chile.matiz}</p>
    </div>

    <div class="chart">
      <div class="chart-h">
        <p class="chart-t">Lo que sí está vigente o por entrar en vigencia</p>
        <p class="chart-s">Ninguna de estas normas nombra criptografía post-cuántica.</p>
      </div>
      <div class="chart-b"><div class="tw">
        <table>
          <thead><tr><th>Norma</th><th>Qué establece</th><th>Estado</th></tr></thead>
          <tbody>
            {d.chile.normas.map((n: any) => (
              <tr>
                <td>{n.n}</td>
                <td>{n.q}</td>
                <td><span class={`chip ${n.estado === 'ok' ? 'ok' : n.estado === 'pendiente' ? 'warn' : 'crit'}`}>{n.f}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="src">Las marcadas «por verificar» no se publican hasta confirmarse contra la fuente primaria del regulador. Se muestran acá porque este documento es un borrador de trabajo.</p>
      </div>
    </div>

    <div class="pull"><p>El regulador es el único de los cuatro relojes que le va a avisar antes. Los otros tres ya sonaron.</p></div>
  </section>

  <section id="indice">
    <div class="sechead">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18"/><path d="M6 20V9M11 20V5M16 20v-7M21 20v-4"/></svg>
      <span class="snum">04 · El índice</span>
    </div>
    <h2>{d.indice.nombre}</h2>
    <div class="measure">
      <p class="lede">Un número entre 0 y {d.indice.tope} que resume la exposición criptográfica observable de una organización desde afuera. Se recalcula cada mes con el mismo método, para que la serie signifique algo.</p>
      <p>La diferencia con cualquier otro estudio de ciberseguridad está en el origen del dato: <strong>estas cuatro dimensiones se miden sobre endpoints reales</strong>, no se preguntan. Y las declaramos completas —incluidos sus pesos y sus límites— para que cualquiera pueda reproducir el cálculo o discutirlo.</p>
    </div>

    <div class="panel">
      <div class="panel-h">
        <h3>Cómo se compone · {d.indice.version}</h3>
        <span class="meta">n = {d.indice.n} organizaciones chilenas</span>
      </div>
      <div class="chart-b"><div class="tw">
        <table>
          <thead><tr><th>Dimensión</th><th class="num">Peso</th><th>Origen</th><th>Qué mide y por qué pesa lo que pesa</th><th class="num">Mediana</th></tr></thead>
          <tbody>
            {d.indice.dimensiones.map((x: any) => (
              <tr>
                <td><strong>{x.k}</strong></td>
                <td class="num">{x.peso}%</td>
                <td><span class={`chip ${x.tipo === 'medido' ? 'ok' : 'warn'}`}>{x.tipo}</span></td>
                <td>{x.que}<br /><span style="color:var(--muted)">{x.porque}</span></td>
                <td class="num">{x.mediana}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="src">Una dimensión marcada <strong>modelo</strong> no se midió en sus sistemas: se deriva del perfil de su sector. La distinción se conserva en todo el informe.</p>
      </div>
    </div>

    <div class="chart">
      <div class="chart-h">
        <p class="chart-t">Dónde cae la gran empresa chilena</p>
        <p class="chart-s">Distribución del índice sobre {d.indice.n} organizaciones. Mediana {d.indice.mediana}, rango {d.indice.min}–{d.indice.max}.</p>
      </div>
      <div class="chart-b">
        <div class="bars">
          {d.indice.distribucion.map((t: any) => (
            <div class="bar-row">
              <span class="bar-lab">{t.rango}</span>
              <div class="bar-track"><div class={`bar-fill ${t.n===0?'':'mid'}`} style={`width:${Math.round(t.pct/28*100)}%`}></div></div>
              <span class="bar-val">{t.n > 0 ? `${t.n} · ${t.pct}%` : '—'}</span>
            </div>
          ))}
        </div>
        <p class="src">Ninguna organización alcanza el tope de {d.indice.tope}. {d.indice.tope_razon}</p>
      </div>
    </div>

    <div class="measure">
      <p>La curva es angosta y eso <em>es</em> el hallazgo: entre el mejor y el peor hay {d.indice.max - d.indice.min} puntos, y {Math.round(100*Math.max(...Object.values(d.indice.bandas_conteo as Record<string,number>))/d.indice.n)}% de la muestra cae en una sola banda. No hay líderes ni rezagados marcados. <strong>Todo el país está en el mismo lugar.</strong></p>
    </div>

    <div class="pull"><p>El {d.indice.certificados_detalle.pct_parametros_deprecados}% de las organizaciones medidas firma con parámetros que el borrador del NIST deprecia después de 2030. Nadie se diferencia porque nadie ha empezado.</p></div>

    <div class="measure">
      <p>La dimensión de mayor peso —certificados, {d.indice.dimensiones[0].peso}%— resulta <strong>prácticamente constante</strong>: el {d.indice.hallazgo_cert.constante_pct}% de la muestra obtiene el mismo valor. De {d.indice.certificados_detalle.total} certificados leídos, {d.indice.certificados_detalle.rsa2048} son RSA-2048 y {d.indice.certificados_detalle.ecdsa_p256} son ECDSA sobre curva P-256. Solo {d.indice.certificados_detalle.rsa_mayor} usan parámetros mayores.</p>
      <p>Eso importa por una razón que separa esta dimensión de todas las demás: <strong>el certificado lo emite y lo gestiona la organización.</strong> No hay proveedor de infraestructura que lo resuelva por contrato, como sí ocurre con el intercambio de claves en el borde.</p>
    </div>

    <div class="chart">
      <div class="chart-h">
        <p class="chart-t">La escala, y dónde cae Chile en ella</p>
