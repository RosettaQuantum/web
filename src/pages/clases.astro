---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../content_html/clases.en.html?raw';
// El archivador va como bloque aparte: su lista la reemplaza el Worker desde D1
// (patron del indice de la Biblioteca). El cascaron construido es el respaldo si
// la base no responde.
import archivador from '../content_html/archivador.en.html?raw';
import css from '../styles/pages/clases.css?raw';
import refs from '../content_html/clases.refs.json';
---
<BaseLayout title={'Problem Classes — Rosetta Q'} description={'The map of quantum problem classes by tier, and the algorithm archive served from the database: every entry with its source, its declared speedup and its papers.'} lang="en" altUrl="/es/clases" pageCss={css} scripts={refs}>
  <Fragment set:html={content} />
  <Fragment set:html={archivador} />
</BaseLayout>
