---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const pillars = { A:'State by problem class', B:'Canonical dictionary', C:'Claim explainers', D:'Methodology & runs', E:'Maps & data', F:'Decision-maker' };
const SEALED_RUNS = 48;         // bump on every published run batch — real count only
// only optimization runs (portfolio + grid) have a proven optimum to be at; the
// molecular ones are scored by percentile, so they can't feed that claim
const OPTIMIZATION_RUNS = 29;
const PROBLEM_CLASSES = 3;      // portfolio · grid expansion · molecular allostery
const lastDate = posts[0]?.data.date ?? '';
---
<BlogLayout title="Evidence Library — Rosetta Q" description="Questions answered with sealed, reproducible evidence. Dated, sourced, citable — negatives included." lang="en" altUrl="/es/blog" altHreflang="/es/blog">
  <header class="blog-hero">
    <div class="wrap">
      <div class="eyebrow">Evidence Library · dated · sourced · citable</div>
      <h1>Questions answered with sealed evidence.</h1>
      <p>Every entry answers one question with the citable answer up top, a validity date, and sources underneath. Run entries link to sha256-sealed archives anyone can verify. We publish the negatives.</p>
      <div class="lib-stats" aria-label="Library state, real counts">
        <span><b>{SEALED_RUNS}</b> sealed runs</span>
        <span><b>{posts.length}</b> entries</span>
        <span><b>{PROBLEM_CLASSES}</b> problem classes</span>
        <span><b>0</b> quantum wins measured</span>
        <span><b>{OPTIMIZATION_RUNS}/{OPTIMIZATION_RUNS}</b> optimization runs: classical at proven optimum</span>
        <span>updated <b>{lastDate}</b></span>
      </div>
      <div class="lib-controls">
        <input id="libq" type="search" placeholder="Search a question… (e.g. QAOA, portfolio, NIST, VC)" aria-label="Search the library" />
        <div class="chips" role="group" aria-label="Filter by pillar">
          <button class="chip on" data-p="*">All</button>
          {Object.entries(pillars).map(([k, v]) => <button class="chip" data-p={k}>{k} · {v}</button>)}
        </div>
      </div>
    </div>
  </header>
  <section class="wrap">
    <div class="post-list" id="liblist">
      {posts.map(p => (
        <a class="post-item lib-entry" href={`/blog/${p.id}`} data-pillar={p.data.pillar}>
          <div class="q">{p.data.title}</div>
          <div class="meta">{p.data.date} · Pillar {p.data.pillar} — {pillars[p.data.pillar]}</div>
          <div class="tl">{p.data.tldr}</div>
        </a>
      ))}
    </div>
    <p id="libempty" style="display:none;color:#6E675C;font-family:'IBM Plex Mono',monospace;font-size:0.85rem">No entries match. The library is young — ask us and it becomes the next entry.</p>
  </section>
  <style>
    .lib-stats{display:flex;flex-wrap:wrap;gap:1.2rem;margin-top:1.2rem;font-family:'IBM Plex Mono',monospace;font-size:0.78rem;color:#B5AC99}
    .lib-stats b{color:#4DC4B5;font-weight:600}
    .lib-controls{margin-top:1.4rem}
    #libq{width:100%;max-width:560px;background:#100E0B;border:1px solid #3D372F;border-radius:2px;color:#F4EEDF;font-family:'IBM Plex Mono',monospace;font-size:0.85rem;padding:0.65rem 0.9rem;outline:none}
    #libq:focus{border-color:#4DC4B5}
    .chips{display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.7rem}
    .chip{background:transparent;border:1px solid #3D372F;border-radius:20px;color:#B5AC99;font-family:'IBM Plex Mono',monospace;font-size:0.7rem;padding:0.28rem 0.75rem;cursor:pointer}
    .chip.on{border-color:#D9B87A;color:#D9B87A}
  </style>
  <script>
    const q = document.getElementById('libq');
    const chips = [...document.querySelectorAll('.chip')];
    const items = [...document.querySelectorAll('.lib-entry')];
    const empty = document.getElementById('libempty');
    let pillar = '*';
    function apply() {
      const term = (q.value || '').toLowerCase();
      let shown = 0;
      for (const it of items) {
        const ok = (pillar === '*' || it.dataset.pillar === pillar) && (!term || it.textContent.toLowerCase().includes(term));
        it.style.display = ok ? '' : 'none';
        if (ok) shown++;
      }
      empty.style.display = shown ? 'none' : '';
    }
    q.addEventListener('input', apply);
    chips.forEach(c => c.addEventListener('click', () => { chips.forEach(x => x.classList.remove('on')); c.classList.add('on'); pillar = c.dataset.p; apply(); }));
  </script>
</BlogLayout>
