---
/**
 * La especificación de rosetta-ficha/1 (16-nov-2026), en /protocolo/ficha y /es/protocolo/ficha.
 * El texto vive en public/js/qready-textos.mjs (FICHA_SPEC, PROVISORIO). Los títulos de las 7
 * secciones y el ejemplo NO se escriben aquí: salen de public/js/ficha.mjs con la foto fija F de
 * scripts/fixtures/ficha/, la misma que fija el snapshot de scripts/check-ficha.mjs.
 */
import { FICHA_SPEC, textosFicha } from '../../public/js/qready-textos.mjs';
import { armarFicha, markdownDe, htmlDe, CSS_FICHA } from '../../public/js/ficha.mjs';
import fx from '../../scripts/fixtures/ficha/f.json';
// (18-nov-2026) La escala de la nota sale de ESCALA_NOTA (qex-nucleo.mjs) por rubrica-qex.mjs: no se escribe aquí.
import { escalaPublicada, RUBRICA_URL } from '../../public/js/rubrica-qex.mjs';
import REFERENCIA from '../../public/data/qex-referencia-2026-08.json';
const { lang = 'es' } = Astro.props;
const T = FICHA_SPEC[lang === 'en' ? 'en' : 'es'];
const F = textosFicha(lang);
const fichaEj = armarFicha(fx.foto, { ...fx.ctx, idioma: lang === 'en' ? 'en' : 'es' });
const ejemplo = markdownDe(fichaEj);
// la misma ficha, como la pinta la web y el PDF (htmlDe): una sola fuente
const ejemploHtml = htmlDe(fichaEj);
const escala = escalaPublicada(lang === 'en' ? 'en' : 'es');
const rubrica = RUBRICA_URL[lang === 'en' ? 'en' : 'es'].replace('https://rosettaquantum.com', '');
// la edición de la tabla HNDL sale de la referencia publicada, no se escribe a mano
const catalogo = T.catalogo.map((f) => f.map((c) => c.replace('{edicion}', REFERENCIA.edicion)));
const forma = `"presentacion": {
  "protocolo": "rosetta-ficha/1",
  "spec": "https://rosettaquantum.com/protocolo/ficha",
  "instruccion_agente": "…",
  "idioma": "es" | "en",
  "markdown": "…",
  "ficha": {
    "encabezado": { "dominio": "…", "sector": "…", "pais": "CL" | null, "medido_utc": "…" },
    "veredicto": { "lectura": "…", "referencia": "…", "publicacion": "…" },
    "indicadores": { "RQ.S.00": { "valor": "B", "unidad": null, "texto": "B", "tipo": "medido", "metodo": "QREADY-NOTA-2.1" },
                     "RQ.S.01": { "valor": 56, "unidad": "/100", "tope": 84, "tipo": "medido", "metodo": "QEX-1.0" }, … },
    "alertas": [ { "id": "A1", "nivel": "GRAVE", "codigo": "…", "hallazgo": "…", "donde": "…" } ],
    "acciones": [ { "id": "H1", "accion": "…", "resuelve": ["A1"], "efecto": "B" | null } ],
    "no_medido": [ "…" ], "evidencia": { … }, "limites": [ "…" ], "pie": "…"
  }
}`;
---
<section class="qv qv-spec"><div class="qv-wrap">
  <p class="qv-eyebrow">{T.eyebrow}</p>
  <h1 class="qv-h1">{T.titulo}</h1>
  <p class="qv-lede">{T.lede}</p>

  <h2>{T.h_bloque}</h2>
  <p>{T.bloque}</p>
  <pre class="qv-pre">{forma}</pre>
  <p><code>instruccion_agente</code>: {F.instruccion_agente}</p>

  <h2>{T.h_secciones}</h2>
  <ul>{F.secciones.map((s, i) => <li><code>{String(i + 1).padStart(2, '0')}</code> {s}</li>)}</ul>
  <p>{T.secciones_nota}</p>

  <h2>{T.h_catalogo}</h2>
  <table>
    <tr><th>{T.col_id}</th><th>{T.col_indicador}</th><th>{T.col_valor}</th><th>{T.col_tipo}</th></tr>
    {catalogo.map((f) => <tr><td><code>{f[0]}</code></td><td>{f[1]}</td><td>{f[2]}</td><td>{f[3]}</td></tr>)}
  </table>
  <p>{T.catalogo_nota}</p>

  <h2>{T.h_reglas}</h2>
  <ul>{T.reglas.map((r) => <li>{r}</li>)}</ul>

  <h2>{T.h_ejemplo}</h2>
  <p>{T.ejemplo_nota}</p>
  <pre class="qv-pre">{ejemplo}</pre>
  <style set:html={CSS_FICHA}></style>
  <div class="qv-ficha-ej" set:html={ejemploHtml}></div>

  <h2>{T.h_validar}</h2>
  <p>{T.validar}</p>

  <h2 id="escala">{T.h_escala}</h2>
  <p>{T.escala_nota}</p>
  <div class="qv-tabla-caja"><table>
    <tr><th>{T.col_nota}</th><th>{T.col_condicion}</th><th>{T.col_desde}</th></tr>
    {escala.map((e) => <tr><td><b>{e.nota}</b></td><td>{e.condicion}</td><td><code>{e.desde}</code></td></tr>)}
  </table></div>
  <p><a href={rubrica}>{T.rubrica}</a></p>
</div></section>
