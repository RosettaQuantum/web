---
/**
 * Aviso de la guía PQC en todo el sitio (17-nov-2026). El comportamiento vive en
 * public/js/promo-guia.js; aquí sólo el marcado y el estilo.
 *
 * NACE OCULTO (`hidden`) y así queda salvo que el Worker diga que sí: flag `promo_guia` en '1'
 * en la tabla site_flags Y la guía con published=1 (lib/guia.mjs → /api/promo/guia). Por eso
 * el `href` de abajo es sólo el de respaldo: el script lo reemplaza por la guía publicada.
 *
 * LOS TEXTOS SON LOS APROBADOS POR NICHOLAS, LITERALES (CLAUDE.md §5). «Cerrar»/«Close» es la
 * misma etiqueta que ya usa el modal de leads. No se reescriben aquí.
 *
 * El logo es /rosetta-mark.svg tal cual, sin redibujar. Va en `data-src` y el script lo pone en
 * `src` al mostrarse: mientras el aviso no aparece, la página no pide ni un byte de él.
 */
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const t = es
  ? { msg: 'Nuevo · La guía medida de criptografía post-cuántica — 14 capítulos, 60 fuentes, PDF gratis',
      cta: 'Leer la guía', cerrar: 'Cerrar', href: '/guia/criptografia-post-cuantica' }
  : { msg: 'New · The measured post-quantum cryptography guide — 14 chapters, 60 sources, free PDF',
      cta: 'Read the guide', cerrar: 'Close', href: '/guide/post-quantum-cryptography' };
---
<aside class="rq-promo" id="rqPromo" data-lang={es ? 'es' : 'en'} aria-labelledby="rqPromoMsg" hidden>
  <img class="rq-promo-marca" data-src="/rosetta-mark.svg" alt="" width="18" height="24" />
  <p class="rq-promo-msg" id="rqPromoMsg">{t.msg}</p>
  <a class="rq-promo-ir" href={t.href} data-promo-ir>{t.cta}</a>
  <button type="button" class="rq-promo-x" data-promo-cerrar aria-label={t.cerrar}>✕</button>
</aside>
<style is:global>
/* Paleta de la marca: papel, tinta y el teal. El teal VIVO #0F8B7E va sólo en el filete,
   que no es texto (3,82:1 sobre papel no alcanza AA para letra); el botón usa --verdict,
   el teal de texto (5,29:1). Tamaños sólo de la escala de tokens.css: --t-small, --t-label,
   --t-body. Nada bajo 13 px. */
.rq-promo{position:fixed;right:24px;bottom:24px;z-index:150;width:360px;max-width:calc(100vw - 48px);
  display:grid;grid-template-columns:18px 1fr 44px;grid-template-areas:"marca msg x" ". ir x";
  column-gap:12px;row-gap:12px;align-items:start;
  background:var(--paper);color:var(--ink);border:1px solid var(--line);border-left:3px solid #0F8B7E;
  border-radius:2px;padding:16px 8px 16px 16px;box-shadow:0 8px 28px rgba(22,24,27,.12);font-family:var(--sans)}
.rq-promo[hidden]{display:none}
.lead-ov.open ~ .rq-promo{display:none}
.rq-promo-marca{grid-area:marca;width:18px;height:24px;margin-top:2px}
.rq-promo-msg{grid-area:msg;margin:0;font-size:var(--t-small);line-height:var(--lh-small);color:var(--ink)}
.rq-promo-ir{grid-area:ir;justify-self:start;display:inline-flex;align-items:center;min-height:40px;padding:0 16px;
  background:var(--verdict);color:var(--paper);border:1px solid var(--verdict);border-radius:2px;
  font-family:var(--sans);font-weight:500;font-size:var(--t-small);text-decoration:none}
.rq-promo-ir:hover{background:var(--paper);color:var(--verdict)}
.rq-promo-x{grid-area:x;width:44px;height:44px;margin:-12px 0 0;background:none;border:0;border-radius:2px;
  color:var(--ink-60);font-size:var(--t-body);line-height:1;cursor:pointer}
.rq-promo-x:hover{color:var(--ink)}
.rq-promo-ir:focus-visible,.rq-promo-x:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
/* Móvil (<600 px): barra delgada pegada abajo, a todo el ancho. */
@media (max-width:599px){
  .rq-promo{left:0;right:0;bottom:0;width:auto;max-width:none;border-left:0;border-right:0;border-bottom:0;
    border-top:3px solid #0F8B7E;border-radius:0;box-shadow:0 -4px 16px rgba(22,24,27,.08);
    grid-template-columns:18px 1fr auto 44px;grid-template-areas:"marca msg ir x";column-gap:10px;
    align-items:center;padding:8px 4px 8px 12px}
  .rq-promo-msg{font-size:var(--t-label);line-height:var(--lh-label)}
  .rq-promo-ir{min-height:44px;padding:0 12px;font-size:var(--t-label)}
  .rq-promo-x{margin:0}
}
@media (prefers-reduced-motion:no-preference){
  .rq-promo:not([hidden]){animation:rq-promo-entra .24s ease-out}
  @keyframes rq-promo-entra{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
}
</style>
<script is:inline src="/js/promo-guia.js" defer></script>
