const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const p = (path) => es ? `/es${path}` : path;
import { PESOS, ORDEN, BANDAS, score, banda, leyenda } from '../../lib/qex.js';
import { GRUPOS, ACCION, TRAMPAS, JURISDICCIONES } from '../../lib/qready-proveedores.js';
const JUR = JURISDICCIONES.cl;

/* Dimensiones medidas de la empresa de ejemplo. El score NO se escribe a mano:
   sale de estos valores con la ponderacion canonica (src/lib/qex.js). */
/* El valor de `edge` sale del inventario, no de una impresion: 2 de los 5 hosts
   (www y online, detras de Cloudflare) negocian el hibrido; los otros 3 no tienen
   CDN de por medio y van en clasico puro. 2/5 = 40.
   Antes decia 5 y el inventario marcaba «No» en los cinco, mientras la seccion
   «que esta bien» afirmaba que Cloudflare ya lo negocia. Tres numeros del mismo
   informe contradiciendose. (2026-08-21) */
const VALORES = { cert: 40, higiene: 52, hndl: 15, edge: 40 };
const SCORE = score(VALORES);
const B = banda(SCORE);
const R = 92, C = 2 * Math.PI * R, dash = (SCORE/100)*C;

/* ---------- «El Runway»: un grafico, tres preguntas ----------
   Donde esta la organizacion (el punto), contra su sector (la banda), y cuanto
   tiempo antes de que el riesgo sea probable (las zonas de fondo, del GRI).
   Nada decorativo: cada elemento es un dato del informe.

   NO lleva linea de trayectoria proyectada a proposito -- no existe un modelo que
   calcule que puntaje resulta de ejecutar el roadmap, y dibujarla seria inventar
   un dato. La ausencia de esa linea es una decision, no un olvido. */
const RW = { x0: 150, x1: 880, y0: 30, y1: 350, anios: 15 };
const rwY = (v: number) => RW.y1 - (v / 100) * (RW.y1 - RW.y0);
const rwX = (a: number) => RW.x0 + (a / RW.anios) * (RW.x1 - RW.x0);
/* Zonas de probabilidad del Global Risk Institute. El ano se convierte a distancia
   desde hoy, asi que la edicion del proximo mes las desplaza sola. */
const HOY = 2026;
const ZONAS = [
  { a: 2030, es: '2030 · GRI: ≥1 en 4', en: '2030 · GRI: ≥1 in 4', op: .06 },
  { a: 2035, es: '2035 · GRI: ≥1 en 2', en: '2035 · GRI: ≥1 in 2', op: .11 },
  { a: 2041, es: '~2041 · 51–70 %',     en: '~2041 · 51–70 %',     op: .17 },
];
const BANDAS_RW = [...BANDAS].reverse();


/* Comparacion con pares. Sale del estudio nacional de agosto de 2026
   (cortes-por-sector-2026-08.json), no de una estimacion. La regla n>=8 se
   aplica por metrica: banca tiene n=12 en indice y n=15 en soporte hibrido. */
const PARES = { sector:'Banca', n:12, mediana:57, p25:56, p75:58, min:46, max:60,
                nacMediana:57, nacN:170, hibridoSector:93, hibridoN:15,
                escaneo:'2026-07-31 → 2026-08-02' };

const t = es ? {
