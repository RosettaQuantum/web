      cierre: 'We would rather you spend nothing this year on good evidence than a fortune on a demo.',
    },
  },
};

const t = T[puerta][es ? 'es' : 'en'];

/* A donde apunta cada puerta.
 *
 * V-0012 es HTML suelto en public/ y no tiene cara en espanol, asi que la ruta de la
 * muestra es la misma en los dos idiomas — un enlace a una pagina que existe vale mas
 * que uno traducido a un 404.
 *
 * DOS DESTINOS QUE CORREGI AL COMPROBARLOS, y los dos fallaban en silencio:
 *   · /ledger#corridas NO existe. Las unicas anclas de /ledger son #contenido,
 *     #erratas y #frescura. El enlace habria cargado bien y dejado al lector en el
 *     tope de la pagina, que es el mismo defecto de /errata del 9-sep: «funciona» y
 *     te deja en otra parte de la que dice.
 *   · La Biblioteca es /library y /es/biblioteca. /clases responde 200 pero es el
 *     archivador de los 74 algoritmos, no la Library que nombra el copy.
 * Comprobado contra produccion antes de escribirlo, no contra el menu. */
const DESTINO = {
  investors: { muestra: '/services/sample-report/', ledger: es ? '/es/ledger' : '/ledger' },
  pilots:    { muestra: '/services/sample-report/', ledger: es ? '/es/ledger' : '/ledger' },
  industry:  { muestra: es ? '/es/biblioteca' : '/library', ledger: es ? '/es/ledger' : '/ledger' },
};
const d = DESTINO[puerta];
const contacto = es ? '/es/contacto' : '/contact';
const servicios = es ? '/es/servicios' : '/services';
const compara = es ? '/es/como-comparamos' : '/how-we-compare';
---
<section class="pg" style="border-top:none"><div class="wrap">
  <div class="eyebrow">{t.eyebrow}</div>
  <h1>{t.h1}</h1>
  <p class="lede">{t.lede}</p>
  <p style="margin-top:18px">
    <a class="btn btn-solid" href={contacto}>{es ? 'Escríbenos →' : 'Get in touch →'}</a>
    <a class="btn btn-ghost" href={d.muestra}>{t.muestra}</a>
  </p>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.hoyH}</div>
  <h2>{t.hoyH}</h2>
  <ul class="puerta-hoy">
    {t.hoy.map((linea) => (<li>{linea}</li>))}
  </ul>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.queH}</div>
  <h2>{t.queH}</h2>
  <p class="lede">{t.que}</p>
  <h3>{t.recibesH}</h3>
  <p>{t.recibes}</p>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.precioH}</div>
  <h2>{t.precioH}</h2>
  <p class="lede">{t.precio}</p>
  <p set:html={t.precio2}></p>
  <p class="sealline mono" style="margin-top:12px">
    <a href={servicios}>{es ? 'Todos los precios →' : 'All pricing →'}</a> · <a href={compara}>{es ? 'Con qué más puedes compararnos →' : 'What else you could use →'}</a>
  </p>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.ledgerH}</div>
  <h2>{t.ledgerH}</h2>
  <p>{t.ledger}</p>
  <p class="sealline mono" style="margin-top:12px"><a href={d.ledger}>{t.ledgerCta}</a></p>
</div></section>

<section class="puerta-cierre"><div class="wrap">
  <p class="lede">{t.cierre}</p>
</div></section>
