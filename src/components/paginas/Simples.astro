---
/**
 * /errata · /contact · /monitor · /verify — commit 9. Cuatro paginas cortas, un
 * componente con un `tipo`, para que compartan chrome y reglas en vez de repetirlas.
 *
 * /verify recomputa el sha256 EN EL NAVEGADOR con SubtleCrypto: el archivo no sube a
 * ningun lado y el lector no tiene que confiar en nuestro servidor para comprobar
 * nuestro sello. Un verificador que corre en nuestro servidor no verifica nada.
 */
const { lang = 'en', tipo } = Astro.props;
const es = lang === 'es';
const T = {
  errata: es ? {
    eyebrow:'Erratas', h1:'Cuando nos equivocamos, queda escrito.',
    lede:'Un sello publicado nunca se reescribe. Cuando encontramos un error propio, publicamos la corrección como un archivo nuevo que cita al original por su hash: el original queda intacto y consultable. Cuatro erratas hoy; una se retracta de tres afirmaciones nuestras.',
  } : {
    eyebrow:'Errata', h1:'When we are wrong, it stays on the record.',
    lede:'A published seal is never rewritten. When we find our own error, we publish the correction as a new file that cites the original by its hash: the original stays intact and checkable. Four errata today; one retracts three of our own claims.',
  },
  contact: es ? {
    eyebrow:'Contacto', h1:'Escríbenos.',
    lede:'Un piloto que necesita árbitro, un claim que necesita screening, o una pregunta sobre la metodología. Respondemos desde la misma casilla institucional que firma los informes.',
    campos:['Tu correo','Cuéntanos en una línea'], boton:'Enviar', ok:'Recibido ✓', mal:'No se pudo enviar. Escríbenos directo a hello@rosettaquantum.com.',
  } : {
    eyebrow:'Contact', h1:'Get in touch.',
    lede:'A pilot that needs a referee, a claim that needs screening, or a question about the methodology. We answer from the same institutional address that signs the reports.',
    campos:['Your email','One line about what you need'], boton:'Send', ok:'Received ✓', mal:'Could not send. Write to hello@rosettaquantum.com directly.',
  },
  monitor: es ? {
    eyebrow:'RQ Advantage Monitor · Edición 001 · en preparación', h1:'Lo que el ledger ya puede decir.',
    lede:'Una edición cuando selle. Sin lista, sin goteo. Los hallazgos salen del archivo: qué claims siguen en pie, cuáles se erosionaron y en cuántos días llegó el primer desafío.',
    ph:'tu@firma.com', boton:'Recibe la Edición 001 cuando selle', pie:'un solo correo cuando la edición selle · sin lista, sin goteo',
    ok:'Anotado ✓', mal:'No se pudo anotar. Escríbenos a hello@rosettaquantum.com.',
  } : {
    eyebrow:'RQ Advantage Monitor · Edition 001 · in preparation', h1:'What the ledger can already say.',
    lede:'One edition when it seals. No list, no drip. The findings come out of the archive: which claims are still standing, which eroded, and how many days it took the first challenge to arrive.',
    ph:'you@firm.com', boton:'Get Edition 001 when it seals', pie:'one email when the edition seals · no list, no drip',
    ok:"You're on the list ✓", mal:'Could not sign you up. Write to hello@rosettaquantum.com.',
  },
  verify: es ? {
    eyebrow:'Verifica un sello', h1:'Comprueba nuestro sello sin confiar en nosotros.',
    lede:'Elige un artefacto del ledger y tu navegador recomputa su sello y lo compara con el declarado. El cálculo ocurre en tu máquina: un verificador que corriera en nuestro servidor no verificaría nada.',
    l1:'Artefacto del ledger', l2:'…o pega un id', l3:'Recomputar el sello',
    receta:'content_hash NO es el sha256 del archivo: es el sha256 de su forma canónica — el documento sin meta.content_hash, sin meta.schema y sin storage, serializado con JCS (RFC 8785). Esta página implementa la convención v3, la vigente. El archivo tiene tres convenciones anteriores; para ésas, verificar.py las prueba las cuatro y dice con cuál calzó.',
  } : {
    eyebrow:'Verify a seal', h1:'Check our seal without trusting us.',
    lede:'Pick an artifact from the ledger and your browser recomputes its seal and compares it with the declared one. The computation happens on your machine: a verifier running on our server would verify nothing.',
    l1:'Ledger artifact', l2:'…or paste an id', l3:'Recompute the seal',
    receta:'content_hash is NOT the sha256 of the file: it is the sha256 of its canonical form — the document without meta.content_hash, without meta.schema and without storage, serialized with JCS (RFC 8785). This page implements convention v3, the current one. The archive has three earlier ones; for those, verificar.py tries all four and says which one matched.',
  },
}[tipo];
---
<section class="pg" style="border-top:none"><div class="wrap">
  <div class="eyebrow">{T.eyebrow}</div>
  <h1>{T.h1}</h1>
  <p class="lede">{T.lede}</p>

  {tipo === 'errata' && (
    <div id="errBody" style="margin-top:22px"><p class="mono" style="color:var(--ink-60)">/v1/erratas…</p></div>
  )}

  {tipo === 'contact' && (
    <div style="margin-top:20px;max-width:520px">
      <div class="forma"><input id="cMail" type="email" placeholder={T.campos[0]} aria-label={T.campos[0]} /></div>
      <div class="forma"><input id="cMsg" type="text" placeholder={T.campos[1]} aria-label={T.campos[1]} /></div>
      <p><button class="btn btn-solid" type="button" id="cGo" data-ok={T.ok} data-mal={T.mal}>{T.boton}</button></p>
      <p class="sealline mono"><a href="mailto:hello@rosettaquantum.com">hello@rosettaquantum.com</a></p>
    </div>
  )}

  {tipo === 'monitor' && (
    <div style="margin-top:20px">
      <div class="forma">
        <input id="monMail" type="email" placeholder={T.ph} aria-label={T.ph} />
        <a id="monGo" class="btn btn-solid" style="border-radius:0" href="mailto:hello@rosettaquantum.com?subject=Monitor%20Edition%20001" data-ok={T.ok}>{T.boton}</a>
      </div>
      <p class="sealline mono">{T.pie}</p>
    </div>
  )}

  {tipo === 'verify' && (
    <div class="ver-caja" style="margin-top:20px">
      <p class="mono" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-60)">{T.l1}</p>
      <p><select id="vId" style="font-family:var(--mono);font-size:13px;padding:8px;border:1px solid var(--line);background:#FFFFFE;max-width:100%"><option value="">—</option></select></p>
      <p class="mono" style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-60);margin-top:10px">{T.l2}</p>
      <div class="forma" style="max-width:100%"><input id="vIdLibre" type="text" placeholder="RQ-…" aria-label={T.l2} /></div>
      <p><button class="btn btn-solid" type="button" id="vGo">{T.l3}</button></p>
      <div class="r" id="vOut"></div>
      <p class="sealline mono" style="margin-top:14px;color:var(--ink-60)">{T.receta}</p>
    </div>
  )}
  {tipo === 'verify' && <script type="module" src="/js/verificar.js" is:inline></script>}
</div></section>
