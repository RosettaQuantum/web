---
/**
 * /es/q-ready — la puerta de seguridad, en la marca vigente. 15-sep-2026.
 *
 * Nace de la maqueta que Nicholas aprobó esa noche («un botón sutil, una landing elegante
 * de Q-Ready al nuevo diseño, el pop-up con el informe mensual y el form para el informe
 * individual»). Reemplaza a QrLanding, que seguía en la identidad retirada, con un precio
 * que nadie aprobó (USD 990/año), una entrega prometida en 24–72 h y el formulario de
 * «clase de problema» del laboratorio.
 *
 * ── EL INTERRUPTOR ─────────────────────────────────────────────────────────────────────
 * INFORME_PUBLICO decide si esta página muestra las cifras del informe de la industria y
 * ofrece recibirlo. Sale en FALSE, y no por timidez: el PDF de agosto dice en su p1
 * «Borrador de trabajo. Pendiente antes de publicar: revisión legal…» y su p34 imprime los
 * seis puntos pendientes. Ofrecer ese informe desde una página pública es publicarlo antes
 * de la condición que el propio documento pone. Cuando la revisión legal cierre, cambiar
 * esta constante a true enciende: la tarjeta del índice, la sección de cifras (cada una con
 * su enlace a la fuente) y la tarjeta del informe en el pop-up.
 *
 * ── TODO NÚMERO SALE DEL JSON ──────────────────────────────────────────────────────────
 * Nada va escrito a mano: la edición más reciente de src/data/informe-pqc se lee igual que
 * la lee /informe-pqc, y la línea de tiempo usa su `qday`.
 *
 * ── EL FORMULARIO ──────────────────────────────────────────────────────────────────────
 * Va a /api/qready-lead, que ya existía: escribe la fila en D1 ANTES de avisar a hello@ y
 * sólo confirma si la fila quedó escrita. El JS no muestra «recibido» hasta que el
 * endpoint responde ok. Ver public/js/qready-puerta.js.
 */
const INFORME_PUBLICO = false;

const mods = import.meta.glob('../../data/informe-pqc/*.json', { eager: true });
const ed = Object.entries(mods).map(([p, m]: any) => ({ slug: p.split('/').pop().replace('.json', ''), d: m.default ?? m }))
  .sort((a, b) => b.slug.localeCompare(a.slug))[0];
if (!ed) throw new Error('qready-puerta: no hay ninguna edición en src/data/informe-pqc/');
const d = ed.d;
const T = Object.fromEntries(d.titulares.map((t: any) => [t.id, t]));
const I = d.indice, M = d.muestra;
const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const [yy, mm] = d.edicion.split('-').map(Number);
const mesLargo = `${MESES[mm - 1]} de ${yy}`;
const corta = (iso: string) => { const [, m, dd] = iso.split('-'); return `${+dd}-${MESES[+m - 1].slice(0, 3)}`; };
const ventana = `${corta(d.ventana.desde)} → ${corta(d.ventana.hasta)}`;
const GRI = 'https://globalriskinstitute.org/publication/quantum-threat-timeline-report-2025b/';

// La línea de tiempo: perfil de banca del informe (secreto 8, migración 9) contra `qday`.
const AHORA = 2026, FIN = 2046, MIGRA = 9, SECRETO = 8;
const finMigra = AHORA + MIGRA, hasta = finMigra + SECRETO;
const X0 = 150, X1 = 730;
const x = (a: number) => X0 + (a - AHORA) * (X1 - X0) / (FIN - AHORA);
const ejes = Array.from({ length: (FIN - AHORA) / 5 + 1 }, (_, i) => AHORA + i * 5);
let prev = x(AHORA);
const barras = d.qday.map((q: any) => {
  const año = +q.h.split('·')[1]; const alto = 44 * q.p / 100;
  const r = { x: prev, w: x(año) - prev, y: 182 - alto, h: alto, lx: x(año) - 4, ly: 176 - alto, lab: q.lab };
  prev = x(año); return r;
});
const desc = `Migrar toma ${MIGRA} años, de ${AHORA} a ${finMigra}. Lo último migrado debe seguir secreto ${SECRETO} años más, hasta ${hasta}. `
  + d.qday.map((q: any) => `hacia ${q.h.split('·')[1].trim()} la probabilidad estimada es ${q.lab}`).join('; ') + '.';

const ANCLA: Record<string, string> = { ambientes: 'panel', infra: 'panel', canal: 'panel', hibrido: 'medicion', proveedores: 'ruta' };
const CIFRAS = [
  { id: 'ambientes', sev: 'mal' }, { id: 'infra', sev: 'mal' }, { id: 'canal', sev: 'mal' },
  { id: 'hibrido', sev: '' }, { id: 'proveedores', sev: 'mal', k: 'Proveedores de core con fecha comprometida' },
].map((c) => ({ ...c, t: T[c.id] }));
---
<section class="pg qr-hero" style="border-top:none" id="arriba"><div class={`wrap ${INFORME_PUBLICO ? 'qr-hero-grid' : ''}`}>
  <div>
    <div class="eyebrow">Q-Ready · exposición criptográfica post-cuántica</div>
    <h1>¿Qué tan lista está su criptografía para el momento cuántico?</h1>
    <p class="lede">Medimos desde afuera, sin tocar su red, qué criptografía expone hoy su superficie pública y quién decide de verdad su plazo de migración. Es el mismo método con que medimos a {M.organizaciones} organizaciones chilenas en {mesLargo}.</p>
    <p class="qr-acciones">
      <button type="button" class="btn btn-solid" data-abrir="individual">Solicitar mi informe individual</button>
      {INFORME_PUBLICO && <button type="button" class="qr-link" data-abrir="informe">o reciba el informe de la industria →</button>}
    </p>
    <p class="qr-nota">El informe individual es gratis y confidencial: no se publica ni se comparte.</p>
  </div>
  {INFORME_PUBLICO && (
    <aside class="qr-prueba" aria-label={`Índice nacional de ${mesLargo}`}>
      <div class="qr-prueba-h"><span>Índice QEX</span><span>{mesLargo}</span></div>
      <div class="qr-prueba-n">{I.mediana}<small> / 100 · mediana nacional</small></div>
      <div class="qr-rango-et qr-arriba" aria-hidden="true"><span style={`left:${I.tope}%`}>techo {I.tope}</span></div>
      <div class="qr-rango" aria-hidden="true"><i style={`left:${I.min}%;width:${I.max - I.min}%`}></i><b style={`left:${I.mediana}%`}></b><em style={`left:${I.tope}%`}></em></div>
      <div class="qr-rango-et" aria-hidden="true"><span style={`left:${I.min}%`}>{I.min}</span><span style={`left:${I.max}%`}>{I.max}</span></div>
      <p><a class="qr-base" href="/informe-pqc#indice">n = {I.n} · fuente →</a></p>
      <p>{I.n} organizaciones entre {I.min} y {I.max}. Ninguna llega al techo de {I.tope}: {I.tope_razon.charAt(0).toLowerCase() + I.tope_razon.slice(1)}</p>
    </aside>
  )}
</div></section>

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">Por qué ahora</div>
    <h2>El riesgo empieza hoy, no cuando llegue la máquina.</h2>
    <p>Un adversario con paciencia puede grabar hoy tráfico cifrado y guardarlo, barato, hasta que exista un computador capaz de romper RSA y curvas elípticas. Ese día el archivo se abre hacia atrás: lo que salió cifrado en 2026 queda legible entonces.</p>
    <p class="qr-nota">No afirmamos que a nadie le hayan robado datos. Afirmamos una exposición medible contra un calendario público.</p>
  </div>
  <ol class="qr-hndl">
    <li><b>Graba</b>el tráfico cifrado en tránsito</li>
    <li><b>Guarda</b>a la espera de capacidad</li>
    <li><b>Rompe</b>la clave cuando exista la máquina</li>
    <li><b>Lee</b>lo de hace años, hacia atrás</li>
  </ol>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">Sume los años</div>
  <h2>Si la cuenta da tarde, ya va tarde.</h2>
  <p class="lede qr-medida">Si el tiempo que sus datos deben seguir secretos más el que toma migrar supera el tiempo hasta la amenaza, la organización llega tarde. Con un perfil típico de banca:</p>
  <figure class="qr-reloj">
    <p class="qr-deslice" aria-hidden="true">Deslice para ver hasta {FIN} →</p>
    <div class="qr-reloj-scroll">
      <svg class="reloj-svg" viewBox="0 0 760 250" role="img" aria-labelledby="reloj-t reloj-d">
        <title id="reloj-t">Sume los años</title>
        <desc id="reloj-d">{desc}</desc>
        {ejes.map((a) => (<>
          <line class="rj-grid" x1={x(a)} y1="30" x2={x(a)} y2="206" />
          <text class="rj-eje" x={x(a)} y="226" text-anchor="middle">{a}</text>
        </>))}
        <text class="rj-fila" x="0" y="62">Migrar</text>
        <rect class="rj-migra" x={x(AHORA)} y="48" width={x(finMigra) - x(AHORA)} height="20" rx="2" />
        <text class="rj-dentro" x={x(AHORA) + 10} y="62">{MIGRA} años</text>
        <text class="rj-fila" x="0" y="104">Seguir secreto</text>
        <rect class="rj-secreto" x={x(finMigra)} y="90" width={x(hasta) - x(finMigra)} height="20" rx="2" />
        <text class="rj-dentro" x={x(finMigra) + 10} y="104">{SECRETO} años</text>
        <text class="rj-fila" x="0" y="150">Amenaza</text>
        <text class="rj-fila rj-sub" x="0" y="166">prob. estimada</text>
        {barras.map((b: any) => (<>
          <rect class="rj-prob" x={b.x} y={b.y} width={b.w} height={b.h} />
          <text class="rj-lab" x={b.lx} y={b.ly} text-anchor="end">{b.lab}</text>
        </>))}
        <line class="rj-corte" x1={x(hasta)} y1="30" x2={x(hasta)} y2="206" />
        <text class="rj-corte-t" x={x(hasta) - 8} y="40" text-anchor="end">necesita protección hasta {hasta}</text>
      </svg>
    </div>
    <figcaption>Perfil de ejemplo: secreto {SECRETO} años, migración {MIGRA}. Probabilidades: consenso de 26 expertos del Global Risk Institute; las de 15 y 20 años usan la lectura conservadora. <b>Ninguna de estas fechas es un pronóstico:</b> son la distancia contra la que se planifica. <a class="qr-base" href={GRI} rel="noopener">fuente →</a></figcaption>
  </figure>
</div></section>

{INFORME_PUBLICO && (
  <section id="cifras"><div class="wrap">
    <div class="eyebrow">Informe de la industria · edición {d.numero} · {mesLargo}</div>
    <h2>Lo que medimos en la gran empresa chilena.</h2>
    <p class="lede qr-medida">{M.organizaciones} organizaciones, {M.verticales} verticales, medición {ventana}. Sobre endpoints reales, no una encuesta: cada cifra lleva la base sobre la que se calculó.</p>
    <div class="qr-cifras">
      {CIFRAS.map((c) => (
        <div class={`qr-cifra ${c.sev}`}>
          <span class="qr-n">{c.t.v}{c.t.u || ''}</span>
          <span class="qr-k">{c.k || c.t.k}</span>
          <span class="qr-s">{c.t.sub}</span>
          <a class="qr-base" href={`/informe-pqc#${ANCLA[c.id]}`}>n = {c.t.base} · fuente →</a>
        </div>
      ))}
    </div>
    <p class="qr-nota qr-medida qr-trampa">Casi todo ese 65 % lo activó un proveedor de red por contrato, no una decisión de seguridad. Es la trampa que explica el informe: un número que se pone bueno sin que cambie la exposición.</p>
    <p class="qr-acciones"><button type="button" class="btn btn-ghost" data-abrir="informe">Recibir el informe completo →</button></p>
  </div></section>
)}

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">Su informe individual</div>
    <h2>Lo que recibe su organización.</h2>
    <p>Un documento que un directorio puede leer, con la evidencia detrás. Sale de la medición de su propia superficie pública y lo revisa una persona antes de entregarlo.</p>
    <p class="qr-acciones"><button type="button" class="btn btn-solid" data-abrir="individual">Solicitar mi informe individual</button></p>
    <p class="qr-nota">Gratis. Confidencial: dirigido sólo a su organización, fuera del informe agregado.</p>
  </div>
  <ol class="qr-indice">
    <li><span>01</span><b>Su índice</b>Su número de 0 a 100 frente a la mediana del país y de su sector.</li>
    <li><span>02</span><b>El hallazgo principal</b>Lo que más pesa en su caso, con la evidencia que lo sostiene.</li>
    <li><span>03</span><b>Su superficie pública</b>Qué encontramos en registros públicos y qué responde desde internet.</li>
    <li><span>04</span><b>Su ruta crítica</b>Los proveedores que fijan su plazo real, y cuáles no tienen fecha.</li>
    <li><span>05</span><b>Plan 30 · 90 · 365</b>Qué hacer, en qué orden, y de qué hallazgo sale cada acción.</li>
    <li><span>06</span><b>Alcance y límites</b>Qué mide el informe, qué no puede decir, y cómo reproducirlo.</li>
  </ol>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">Cómo se mide</div>
  <h2>Cuatro pasos, sin tocar su red.</h2>
  <div class="qr-pasos">
    <div class="paso"><b>Usted lo pide</b><p>Con su dominio y un correo de su organización. Medimos sólo lo que alguien de la organización autoriza.</p></div>
    <div class="paso"><b>Leemos registros públicos</b><p>Certificate Transparency muestra cada nombre de host que su organización certificó alguna vez.</p></div>
    <div class="paso"><b>Un saludo por host</b><p>Sobre los hosts críticos abrimos una conexión y enviamos un solo saludo TLS. No se completa: no hay sesión, ni datos, ni credenciales, ni prueba de intrusión.</p></div>
    <div class="paso"><b>Una persona lo revisa</b><p>Un analista revisa el resultado antes de entregárselo y le escribe para coordinar.</p></div>
  </div>
</div></section>

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">Con honestidad</div>
    <h2>Lo que Q-Ready no es.</h2>
  </div>
  <ul class="puerta-hoy">
    <li>No es una certificación, ni reemplaza una revisión interna formal.</li>
    <li>No ve el interior: módulos de seguridad de hardware, core, VPN, firma de código o cifrado en reposo quedan fuera de una medición externa.</li>
    <li>Un número bajo no significa que su organización sea insegura, y uno alto no significa que esté preparada.</li>
    <li>No vende pánico: las fechas de 2030 y 2035 son de política pública, no un pronóstico sobre el hardware.</li>
  </ul>
</div></section>

<section class="puerta-cierre"><div class="wrap qr-cierre">
  <p class="lede">Vea dónde está su criptografía frente al reloj.</p>
  <button type="button" class="btn btn-solid" data-abrir="individual">Solicitar mi informe individual</button>
</div></section>

<div class="qr-velo" id="qr-velo" hidden data-publico={INFORME_PUBLICO ? '1' : '0'}>
  <div class="qr-dialogo" role="dialog" aria-modal="true" aria-labelledby="qr-dialogo-t" tabindex="-1">
    <button type="button" class="qr-cerrar" data-cerrar aria-label="Cerrar">×</button>
    <p class="eyebrow">Q-Ready</p>
    <h2 id="qr-dialogo-t">{INFORME_PUBLICO ? 'Dos formas de empezar.' : 'Pida el informe de su organización.'}</h2>
    <div class={`qr-opciones ${INFORME_PUBLICO ? '' : 'qr-una'}`}>
      {INFORME_PUBLICO && (
        <form class="qr-op qr-op-informe" data-op="informe" novalidate>
          <p class="qr-op-et">Informe de la industria</p>
          <h3>Edición {d.numero} · {mesLargo}</h3>
          <p class="qr-op-meta">{M.organizaciones} organizaciones · {M.verticales} verticales</p>
          <p>Medición técnica sobre endpoints reales de la gran empresa chilena, no una encuesta. Le llega por correo.</p>
          <label>Correo<input type="email" name="email" autocomplete="email" required placeholder="nombre@empresa.cl" /></label>
          <label class="qr-check"><input type="checkbox" name="proxima" /> Avísenme cuando salga la próxima edición</label>
          <button type="submit" class="btn btn-ghost">Enviármelo</button>
          <p class="qr-estado" role="status" hidden></p>
        </form>
      )}
      <form class="qr-op qr-op-individual" data-op="individual" novalidate>
        <p class="qr-op-et">Su informe individual · gratis</p>
        <h3>Su organización, medida.</h3>
        <p>El mismo método, sobre su propia superficie. Confidencial: sólo para su organización.</p>
        <div class="qr-par">
          <label>Organización<input name="legal" autocomplete="organization" required /></label>
          <label>Dominio raíz<input name="dominio" required placeholder="empresa.cl" inputmode="url" autocapitalize="off" spellcheck="false" /></label>
        </div>
        <div class="qr-par">
          <label>Nombre y cargo<input name="name" autocomplete="name" required /></label>
          <label>Correo de la organización<input type="email" name="email" autocomplete="email" required placeholder="nombre@empresa.cl" /></label>
        </div>
        <label class="qr-check"><input type="checkbox" name="autoriza" required /> Represento a esta organización y autorizo medir su superficie pública: un saludo TLS por host, sin acceso a sistemas.</label>
        <button type="submit" class="btn btn-solid">Solicitar mi informe</button>
        <p class="qr-estado" role="status" hidden></p>
      </form>
    </div>
    <p class="qr-pie">Puede pedir su exclusión o el detalle de lo observado cuando quiera, sin costo y sin condiciones.</p>
  </div>
</div>
