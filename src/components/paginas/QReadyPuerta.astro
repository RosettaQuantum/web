---
/**
 * /es/q-ready y /q-ready — la puerta de seguridad, en la marca vigente. 15-sep-2026.
 *
 * 23-nov-2026: la misma portada sirve a los dos idiomas (`lang`). Los textos viven en
 * src/lib/puerta-textos.mjs: el español es el de siempre, sin cambiar una letra; el inglés es
 * PROVISORIO (docs/textos-provisorios-q-ready-en.md). A la derecha del hero va el carrusel de
 * publicaciones (components/publicaciones/CarruselPublicaciones.astro), en el lugar y con el
 * tamaño que tenía la tarjeta del informe.
 *
 * Nace de la maqueta que Nicholas aprobó esa noche («un botón sutil, una landing elegante
 * de Q-Ready al nuevo diseño, el pop-up con el informe mensual y el form para el informe
 * individual»). Reemplaza a QrLanding, que seguía en la identidad retirada, con un precio
 * que nadie aprobó (USD 990/año), una entrega prometida en 24–72 h y el formulario de
 * «clase de problema» del laboratorio.
 *
 * ── EL INTERRUPTOR ─────────────────────────────────────────────────────────────────────
 * INFORME_PUBLICO decide si esta página muestra las cifras del informe de la industria y
 * ofrece recibirlo. Sale en FALSE, y no por timidez: el PDF de agosto dice en su p1
 * «Borrador de trabajo. Pendiente antes de publicar: revisión legal…» y su p34 imprime los
 * seis puntos pendientes. Ofrecer ese informe desde una página pública es publicarlo antes
 * de la condición que el propio documento pone. Cuando la revisión legal cierre, cambiar
 * esta constante a true enciende: la tarjeta del índice, la sección de cifras (cada una con
 * su enlace a la fuente) y la tarjeta del informe en el pop-up.
 *
 * ── TODO NÚMERO SALE DEL JSON ──────────────────────────────────────────────────────────
 * Nada va escrito a mano: la edición más reciente de src/data/informe-pqc se lee igual que
 * la lee /informe-pqc, y la línea de tiempo usa su `qday`.
 *
 * ── EL FORMULARIO ──────────────────────────────────────────────────────────────────────
 * Va a /api/qready-lead, que ya existía: escribe la fila en D1 ANTES de avisar a hello@ y
 * sólo confirma si la fila quedó escrita. El JS no muestra «recibido» hasta que el
 * endpoint responde ok. Ver public/js/qready-puerta.js.
 */
import CarruselPublicaciones from '../publicaciones/CarruselPublicaciones.astro';
import { TEXTOS_PUERTA } from '../../lib/puerta-textos.mjs';
import { llenar } from '../../lib/textos-galeria.mjs';

const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const t = TEXTOS_PUERTA[es ? 'es' : 'en'];

const INFORME_PUBLICO = false;

const mods = import.meta.glob('../../data/informe-pqc/*.json', { eager: true });
const ed = Object.entries(mods).map(([p, m]: any) => ({ slug: p.split('/').pop().replace('.json', ''), d: m.default ?? m }))
  .sort((a, b) => b.slug.localeCompare(a.slug))[0];
if (!ed) throw new Error('qready-puerta: no hay ninguna edición en src/data/informe-pqc/');
const d = ed.d;
const T = Object.fromEntries(d.titulares.map((x: any) => [x.id, x]));
const I = d.indice, M = d.muestra;
const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const [yy, mm] = d.edicion.split('-').map(Number);
const mesLargo = es ? `${MESES[mm - 1]} de ${yy}` : `${MONTHS[mm - 1]} ${yy}`;
const corta = (iso: string) => { const [, m, dd] = iso.split('-'); return `${+dd}-${MESES[+m - 1].slice(0, 3)}`; };
const ventana = `${corta(d.ventana.desde)} → ${corta(d.ventana.hasta)}`;
const GRI = 'https://globalriskinstitute.org/publication/quantum-threat-timeline-report-2025b/';

// La línea de tiempo: perfil de banca del informe (secreto 8, migración 9) contra `qday`.
const AHORA = 2026, FIN = 2046, MIGRA = 9, SECRETO = 8;
const finMigra = AHORA + MIGRA, hasta = finMigra + SECRETO;
const X0 = 150, X1 = 730;
const x = (a: number) => X0 + (a - AHORA) * (X1 - X0) / (FIN - AHORA);
const ejes = Array.from({ length: (FIN - AHORA) / 5 + 1 }, (_, i) => AHORA + i * 5);
let prev = x(AHORA);
const barras = d.qday.map((q: any) => {
  const año = +q.h.split('·')[1]; const alto = 44 * q.p / 100;
  const r = { x: prev, w: x(año) - prev, y: 182 - alto, h: alto, lx: x(año) - 4, ly: 176 - alto, lab: q.lab };
  prev = x(año); return r;
});
const R = t.reloj;
const desc = llenar(R.descA, [MIGRA, AHORA, finMigra, SECRETO, hasta])
  + d.qday.map((q: any) => llenar(R.descItem, [q.h.split('·')[1].trim(), q.lab])).join('; ') + '.';

// ── EL PANEL DEL INFORME DE LA INDUSTRIA ─────────────────────────────────────────────────
// A la derecha del hero desde el 12-nov-2026. El 23-nov pasó a ser la primera diapositiva del
// carrusel de publicaciones, en el mismo lugar y con el mismo tamaño: mismas cifras, mismo
// formulario, mismo criterio (sólo ediciones con borrador:false).

const ANCLA: Record<string, string> = { ambientes: 'panel', infra: 'panel', canal: 'panel', hibrido: 'medicion', proveedores: 'ruta' };
const CIFRAS = [
  { id: 'ambientes', sev: 'mal' }, { id: 'infra', sev: 'mal' }, { id: 'canal', sev: 'mal' },
  { id: 'hibrido', sev: '' }, { id: 'proveedores', sev: 'mal', k: 'Proveedores de core con fecha comprometida' },
].map((c) => ({ ...c, t: T[c.id] }));
---
<section class="pg qr-hero" style="border-top:none" id="arriba"><div class="wrap qr-hero-grid">
  <div>
    <div class="eyebrow">{t.hero.eyebrow}</div>
    <h1>{t.hero.h1}</h1>
    <p class="lede">{llenar(t.hero.lede, [M.organizaciones, mesLargo])}</p>
    <p class="qr-acciones">
      <button type="button" class="btn btn-solid" data-abrir="individual">{t.hero.individual}</button>
      <a class="btn btn-ghost qr-medir" href={t.rutas.medicion}><span class="qr-vivo" aria-hidden="true"></span>{t.hero.medir} <span class="qr-medir-flecha" aria-hidden="true">→</span></a>
      {INFORME_PUBLICO && es && <button type="button" class="qr-link" data-abrir="informe">o reciba el informe de la industria →</button>}
    </p>
    <p class="qr-nota">{t.hero.nota}</p>
  </div>
  <CarruselPublicaciones lang={lang} />
</div></section>

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">{t.ahora.eyebrow}</div>
    <h2>{t.ahora.h2}</h2>
    <p>{t.ahora.p}</p>
    <p class="qr-nota">{t.ahora.nota}</p>
  </div>
  <ol class="qr-hndl">
    {t.ahora.pasos.map(([b, r]: string[]) => <li><b>{b}</b>{r}</li>)}
  </ol>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{R.eyebrow}</div>
  <h2>{R.h2}</h2>
  <p class="lede qr-medida">{R.lede}</p>
  <figure class="qr-reloj">
    <p class="qr-deslice" aria-hidden="true">{llenar(R.deslice, [FIN])}</p>
    <div class="qr-reloj-scroll">
      <svg class="reloj-svg" viewBox="0 0 760 250" role="img" aria-labelledby="reloj-t reloj-d">
        <title id="reloj-t">{R.titulo}</title>
        <desc id="reloj-d">{desc}</desc>
        {ejes.map((a) => (<>
          <line class="rj-grid" x1={x(a)} y1="30" x2={x(a)} y2="206" />
          <text class="rj-eje" x={x(a)} y="226" text-anchor="middle">{a}</text>
        </>))}
        <text class="rj-fila" x="0" y="62">{R.migrar}</text>
        <rect class="rj-migra" x={x(AHORA)} y="48" width={x(finMigra) - x(AHORA)} height="20" rx="2" />
        <text class="rj-dentro" x={x(AHORA) + 10} y="62">{llenar(R.anios, [MIGRA])}</text>
        <text class="rj-fila" x="0" y="104">{R.secreto}</text>
        <rect class="rj-secreto" x={x(finMigra)} y="90" width={x(hasta) - x(finMigra)} height="20" rx="2" />
        <text class="rj-dentro" x={x(finMigra) + 10} y="104">{llenar(R.anios, [SECRETO])}</text>
        <text class="rj-fila" x="0" y="150">{R.amenaza}</text>
        <text class="rj-fila rj-sub" x="0" y="166">{R.prob}</text>
        {barras.map((b: any) => (<>
          <rect class="rj-prob" x={b.x} y={b.y} width={b.w} height={b.h} />
          <text class="rj-lab" x={b.lx} y={b.ly} text-anchor="end">{b.lab}</text>
        </>))}
        <line class="rj-corte" x1={x(hasta)} y1="30" x2={x(hasta)} y2="206" />
        <text class="rj-corte-t" x={x(hasta) - 8} y="40" text-anchor="end">{llenar(R.corte, [hasta])}</text>
      </svg>
    </div>
    <figcaption>{llenar(R.pie, [SECRETO, MIGRA])} <b>{R.pieNegrita}</b> {R.pieCola} <a class="qr-base" href={GRI} rel="noopener">{R.fuente}</a></figcaption>
  </figure>
</div></section>

{INFORME_PUBLICO && es && (
  <section id="cifras"><div class="wrap">
    <div class="eyebrow">Informe de la industria · edición {d.numero} · {mesLargo}</div>
    <h2>Lo que medimos en la gran empresa chilena.</h2>
    <p class="lede qr-medida">{M.organizaciones} organizaciones, {M.verticales} verticales, medición {ventana}. Sobre endpoints reales, no una encuesta: cada cifra lleva la base sobre la que se calculó.</p>
    <div class="qr-cifras">
      {CIFRAS.map((c) => (
        <div class={`qr-cifra ${c.sev}`}>
          <span class="qr-n">{c.t.v}{c.t.u || ''}</span>
          <span class="qr-k">{c.k || c.t.k}</span>
          <span class="qr-s">{c.t.sub}</span>
          <a class="qr-base" href={`/informe-pqc#${ANCLA[c.id]}`}>n = {c.t.base} · fuente →</a>
        </div>
      ))}
    </div>
    <p class="qr-nota qr-medida qr-trampa">Casi todo ese 65 % lo activó un proveedor de red por contrato, no una decisión de seguridad. Es la trampa que explica el informe: un número que se pone bueno sin que cambie la exposición.</p>
    <p class="qr-acciones"><button type="button" class="btn btn-ghost" data-abrir="informe">Recibir el informe completo →</button></p>
  </div></section>
)}

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">{t.individual.eyebrow}</div>
    <h2>{t.individual.h2}</h2>
    <p>{t.individual.p}</p>
    <p class="qr-acciones"><button type="button" class="btn btn-solid" data-abrir="individual">{t.hero.individual}</button></p>
    <p class="qr-nota">{t.individual.nota}</p>
  </div>
  <ol class="qr-indice">
    {t.individual.indice.map(([b, r]: string[], k: number) => <li><span>{String(k + 1).padStart(2, '0')}</span><b>{b}</b>{r}</li>)}
  </ol>
</div></section>

<section><div class="wrap">
  <div class="eyebrow">{t.pasos.eyebrow}</div>
  <h2>{t.pasos.h2}</h2>
  <div class="qr-pasos">
    {t.pasos.lista.map(([b, r]: string[]) => <div class="paso"><b>{b}</b><p>{r}</p></div>)}
  </div>
</div></section>

<section><div class="wrap qr-dos">
  <div>
    <div class="eyebrow">{t.noEs.eyebrow}</div>
    <h2>{t.noEs.h2}</h2>
  </div>
  <ul class="puerta-hoy">
    {t.noEs.lista.map((r: string) => <li>{r}</li>)}
  </ul>
</div></section>

<section class="puerta-cierre"><div class="wrap qr-cierre">
  <p class="lede">{t.cierre.lede}</p>
  <button type="button" class="btn btn-solid" data-abrir="individual">{t.hero.individual}</button>
</div></section>

<div class="qr-velo" id="qr-velo" hidden data-publico={INFORME_PUBLICO && es ? '1' : '0'} data-lang={es ? 'es' : 'en'} data-origen={t.rutas.origen} data-textos={JSON.stringify(t.js)}>
  <div class="qr-dialogo" role="dialog" aria-modal="true" aria-labelledby="qr-dialogo-t" tabindex="-1">
    <button type="button" class="qr-cerrar" data-cerrar aria-label={t.dialogo.cerrar}>×</button>
    <p class="eyebrow">{t.dialogo.eyebrow}</p>
    <h2 id="qr-dialogo-t">{INFORME_PUBLICO && es ? 'Dos formas de empezar.' : t.dialogo.h2}</h2>
    <div class={`qr-opciones ${INFORME_PUBLICO && es ? '' : 'qr-una'}`}>
      {INFORME_PUBLICO && es && (
        <form class="qr-op qr-op-informe" data-op="informe" novalidate>
          <p class="qr-op-et">Informe de la industria</p>
          <h3>Edición {d.numero} · {mesLargo}</h3>
          <p class="qr-op-meta">{M.organizaciones} organizaciones · {M.verticales} verticales</p>
          <p>Medición técnica sobre endpoints reales de la gran empresa chilena, no una encuesta. Le llega por correo.</p>
          <label>Correo<input type="email" name="email" autocomplete="email" required placeholder="nombre@empresa.cl" /></label>
          <label class="qr-check"><input type="checkbox" name="proxima" /> Avísenme cuando salga la próxima edición</label>
        <p class="qr-informe-pie">Guardamos su correo sólo para esto. Para borrarlo, escriba a hello@rosettaquantum.com.</p>
          <button type="submit" class="btn btn-ghost">Enviármelo</button>
          <p class="qr-estado" role="status" hidden></p>
        </form>
      )}
      <form class="qr-op qr-op-individual" data-op="individual" novalidate>
        <p class="qr-op-et">{t.dialogo.et}</p>
        <h3>{t.dialogo.h3}</h3>
        <p>{t.dialogo.p}</p>
        <div class="qr-par">
          <label>{t.dialogo.organizacion}<input name="legal" autocomplete="organization" required /></label>
          <label>{t.dialogo.dominio}<input name="dominio" required placeholder={t.dialogo.dominioEj} inputmode="url" autocapitalize="off" spellcheck="false" /></label>
        </div>
        <div class="qr-par">
          <label>{t.dialogo.nombre}<input name="name" autocomplete="name" required /></label>
          <label>{t.dialogo.correo}<input type="email" name="email" autocomplete="email" required placeholder={t.dialogo.correoEj} /></label>
        </div>
        <label class="qr-check"><input type="checkbox" name="autoriza" required /> {t.dialogo.autoriza}</label>
        <button type="submit" class="btn btn-solid">{t.dialogo.enviar}</button>
        <p class="qr-estado" role="status" hidden></p>
      </form>
    </div>
    <p class="qr-pie">{t.dialogo.pie}</p>
  </div>
</div>
