---
/**
 * /lab/hardware y /es/lab/hardware — «El mismo circuito, dos máquinas».
 *
 * UN COMPONENTE, DOS PÁGINAS. El par en/es es el patrón del repo (ver QReadyPuerta y
 * Comparacion): si el marcado viviera dos veces, un arreglo tendría que acordarse dos veces, y
 * en este proyecto un contrato en dos artefactos ya cambió en un solo paso más de una vez.
 *
 * NINGUNA CIFRA Y NINGUNA PALABRA SE ESCRIBEN AQUÍ. Los doce textos son los aprobados por
 * Nicholas el 25-nov-2026 y viven sellados en `src/data/lab/hardware/`; las cifras las pone el
 * generador leyendo los artefactos de la medición. Este archivo sólo decide dónde va cada cosa.
 * Si falta un archivo, una huella no calza o un texto nombra una cifra que no se midió, el
 * generador lanza y la página no se construye — eso es a propósito: sin medición no hay página.
 *
 * EL AZAR VA PEGADO A LA CIFRA, no al pie. Es la regla de la casa sobre esta clase de número:
 * 900 de 1.000 no significa nada hasta que al lado está el 250 que saca una máquina respondiendo
 * al azar. Separarlos en la pantalla es separarlos en la cabeza del que mira.
 *
 * PANELES EN <div role="region">, NO EN <section>. La base de marca pinta
 * `section:not(.pilot){background:var(--paper)}` y en modo oscuro la repite con `!important`:
 * un <section> con fondo propio sale color papel y ninguna especificidad le gana. Ya pasó en
 * /es/q-ready/medicion.
 */
import { pagina } from '../../lib/lab-hardware.mjs';

const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const { textos: t, medicion: m, deHoy } = pagina(lang);

// LAS DOS COLUMNAS, cada una con su cifra, su histograma y SU PROPIA referencia del azar.
//
// El azar iba antes una sola vez, debajo del conjunto, y en pantalla quedaba colgando bajo la
// columna del simulador: se leía como si los 250 fueran la vara de ESA columna, que es la
// única donde no hacen falta. Donde tiene que estar es al lado del 900.
//
// Y cada histograma lleva el rótulo de SU máquina, que es el defecto que encontró Main: se
// veía un gráfico con picos y ruido y nadie podía saber de cuál de las dos máquinas era. Los
// rótulos son los textos aprobados 5 y 6, los mismos de la cifra; no hay leyenda nueva.
const COLUMNAS = [
  { clave: 'a', rotulo: t.columna_a, tono: 'exacto',
    aciertos: m.aciertos_simulador, cuentas: m.cuentas_simulador },
  { clave: 'b', rotulo: t.columna_b, tono: 'medido',
    aciertos: m.aciertos_hardware, cuentas: m.cuentas_hardware },
];

// LA MISMA ESCALA PARA LOS DOS HISTOGRAMAS: un solo máximo sobre los dos conjuntos. Escalado
// cada uno a su propio máximo, los dos se verían idénticos —picos altos, ruido bajo— y la
// figura diría que el hardware acertó tanto como el simulador exacto.
const maximo = Math.max(
  ...Object.values(m.cuentas_simulador), ...Object.values(m.cuentas_hardware));

// Son NÚMEROS, no texto nuevo: la figura se nombra con el párrafo ya aprobado que explica qué
// se mide, para no meter por la puerta de atrás una leyenda que Nicholas no vio.
const estadosDe = (cuentas) => Array.from({ length: m.estados }, (_, i) => ({
  i,
  cuenta: cuentas[String(i)] ?? 0,
  pico: m.picos.includes(i),
}));
---
<section class="pg lh" style="border-top:none"><div class="wrap">
  <div class="eyebrow">{es ? 'Laboratorio' : 'Laboratory'}</div>
  <h1>{t.titulo}</h1>
  <p class="lede">{t.bajada}</p>

  {/* «Lo que esto no es» va ACÁ, no al pie: es el orden que aprobó Nicholas. Una salvedad al
      pie la lee quien ya se formó una idea equivocada. */}
  <p class="lh-no-es">{t.no_es}</p>
</div></section>

<section><div class="wrap">
  <p class="lede" id="lh-que-se-mide">{t.que_se_mide}</p>

  <div class="lh-marcador" role="region" aria-labelledby="lh-que-se-mide">
    <div class="lh-columnas">
      {COLUMNAS.map((c) => (
        <div class="lh-col" data-tono={c.tono} data-columna={c.clave}>
          <div class="lh-col-rotulo" data-rotulo-de={c.clave}>{c.rotulo}</div>
          <div class="lh-cifra">{c.aciertos.toLocaleString(es ? 'es-CL' : 'en-US')}</div>
          <div class="lh-cifra-pie">{t.rotulo_cifra}</div>
          <div class="lh-barra"><span style={`inline-size:${(100 * c.aciertos / m.disparos).toFixed(1)}%`}></span></div>

          {/* La vara del azar, en ESTA columna y en la misma escala que la barra de arriba.
              Va en las dos: el 900 sin el 250 al lado es el número que el texto aprobado
              dice que no puede viajar solo. */}
          <div class="lh-vara-barra" data-vara-de={c.clave}>
            <span style={`inline-size:${(100 * m.aciertos_azar / m.disparos).toFixed(1)}%`}></span>
          </div>

          {/* Dónde cayeron los 1.000 disparos de ESTA máquina. Los dos histogramas comparten
              el máximo, así que las alturas se pueden comparar de un vistazo. Los cuatro
              picos correctos se saben por matemática antes de encender nada. */}
          <div class="lh-reparto" data-reparto-de={c.clave}>
            {estadosDe(c.cuentas).map((e) => (
              <div class="lh-estado" data-pico={e.pico ? 'si' : 'no'}>
                <div class="lh-estado-barra"><span style={`block-size:${(100 * e.cuenta / maximo).toFixed(1)}%`}></span></div>
                <div class="lh-estado-n">{e.i}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="lh-vara-texto">{t.azar}</p>
  </div>
</div></section>

<section><div class="wrap lh-prosa">
  <p>{t.profundidad}</p>
  <p>{t.rsa}</p>
</div></section>

<section class="puerta-cierre"><div class="wrap">
  <div class="eyebrow">{es ? 'Procedencia' : 'Provenance'}</div>
  <p class="lh-procedencia mono">{t.procedencia}</p>
  {/* Sale sola cuando la medición no es del día. Una corrida vieja es una corrida válida; lo
      que no se puede es dejar que se lea como si fuera de este momento. */}
  {!deHoy && <p class="lh-vieja">{t.no_es_de_ahora}</p>}
</div></section>
