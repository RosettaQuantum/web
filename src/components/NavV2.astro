---
/**
 * Barra de navegación v2 — portada de la maqueta v20 (congelada).
 *
 * Los seis enlaces y el CTA son los de la maqueta; lo unico que cambia son los
 * destinos: la maqueta usa anclas (#pilots) porque es una sola pagina, y aqui van
 * a las rutas reales del spec §1. Las rutas se crean en los commits 7-9: hasta
 * entonces el preview responde 404 en algunas, y esta declarado a proposito — un
 * nav que apunte a anclas muertas seria peor, porque no falla.
 *
 * El logo se sirve como archivo (public/rosetta-mark.svg), no inline: 4 KB de path
 * repetidos en cada pagina es peso, y un SVG copiado a mano se corrompe en silencio.
 */
// `alt`: destino explicito del cambio de idioma. Existe por el cascaron del blog: el
// Worker inserta ahi la ruta del post traducido, y el marcador __RQ_ALT_ + _ tiene que
// sobrevivir a la compilacion. Sin este prop, NavV2 calculaba el alterno desde `ruta` y
// el marcador desaparecia del HTML compilado — el post se habria servido roto.
const { lang = "en", ruta = "/", alt = null } = Astro.props;
const es = lang === "es";

// "Notes" entra el 8-sep: los 106 posts eran la mayor masa indexable del sitio y NO
// tenian puerta desde el chrome — solo desde el pie. Lo encontro Nicholas preguntando
// "¿como accedo al blog?". Se usa la misma palabra que el pie: una sola etiqueta para lo
// mismo en todo el sitio.
const ENLACES = es
  /* B1.8 · Monitor sale del menu. Un item de navegacion que promete un producto y
     entrega 158 palabras cuesta mas credibilidad que cualquier problema tipografico,
     y Nicholas pregunto textualmente "que es la pestaña de monitor?".
     LA PAGINA NO SE BORRA Y NO SE REDIRIGE TODAVIA: el spec manda 301 a
     /ledger#monitor, pero esa ancla no existe hasta que el bloque 10 absorba el
     contenido. Un 301 a un ancla inexistente es el mismo defecto que se arreglo el
     9-sep con /errata: el enlace "funciona" y te deja en otra parte de la que dice.
     Sigue anunciada en llms.txt y en el sitemap, y enlazada desde el pie. */
  ? [["/es/pilotos", "Pilotos"], ["/es/servicios", "Servicios"], ["/es/biblioteca", "Biblioteca"],
     ["/es/ledger", "Ledger"], ["/es/metodologia", "Metodología"],
     ["/es/blog", "Notes"]]
  : [["/pilots", "Pilots"], ["/services", "Services"], ["/library", "Library"],
     ["/ledger", "Ledger"], ["/methodology", "Methodology"],
     ["/blog", "Notes"]];

/* B1.1 · copy del anexo A del spec maestro, aprobado. */
const CTA = es ? ["/es/pilotos", "Pedir un árbitro"] : ["/pilots", "Request a referee"];
const OTRO = alt || (es ? ruta.replace(/^\/es/, "") || "/" : "/es" + (ruta === "/" ? "/" : ruta));
---
<nav>
  <div class="wrap nav-inner">
    <a class="wordmark" href={es ? "/es/" : "/"}>
      <img src="/rosetta-mark.svg" width="34" height="44" alt="" aria-hidden="true" />
      <span class="wm">Rosetta Quantum</span>
    </a>
    <div class="nav-links">
      {ENLACES.map(([h, t]) => <a href={h}>{t}</a>)}
    </div>
    <div class="nav-right">
      <a class="nav-cta" href={CTA[0]}>{CTA[1]}</a>
      <span class="lang">{es ? <a href={OTRO}>EN</a> : <b>EN</b>} / {es ? <b>ES</b> : <a href={OTRO}>ES</a>}</span>
      <button type="button" class="burger" id="burger" aria-label={es ? "Menú" : "Menu"} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  {/* B10.2 · FRESCURA DEL REGISTRO. Un registro sin fecha de actualizacion se asume
      muerto, y este publica 93 corridas selladas sin decir en ningun lado cuando fue la
      ultima. La franja se rellena desde /v1/state y /v1/runs al mirar la pagina; si el
      archivo no responde NO se vacia ni se inventa: se queda con lo que trae el build y
      lo rotula. Los dias se computan al mirar, nunca se hornean. */}
  <div class="frescura" id="frescura" hidden></div>
  <div class="mobile-menu" id="mobileMenu">
    {ENLACES.map(([h, t]) => <a href={h}>{t}</a>)}
    <div class="mm-foot">
      <a class="nav-cta" href={CTA[0]}>{CTA[1]}</a>
      <span>{es ? <a href={OTRO}>EN</a> : <b>EN</b>} / {es ? <b>ES</b> : <a href={OTRO}>ES</a>}</span>
    </div>
  </div>
</nav>
<script is:inline>
  (function () {
    var b = document.getElementById("burger"), m = document.getElementById("mobileMenu");
    if (!b || !m) return;
    b.addEventListener("click", function () {
      var abierto = b.getAttribute("aria-expanded") === "true";
      b.setAttribute("aria-expanded", String(!abierto));
      m.classList.toggle("open", !abierto);
    });
  })();
</script>
