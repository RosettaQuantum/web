---
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const t = es ? {
  title:'Acceso anticipado', sub:'Cuéntanos lo básico y te avisamos apenas abramos tu clase de problema.',
  name:'Nombre', email:'Email', role:'Rol', org:'Empresa / institución',
  pclass:'Clase de problema', note:'¿Qué intentas resolver? (opcional)',
  roles:['Quant / finanzas','Químico computacional','Optimización / OR','Investigación','Otro'],
  classes:['Optimización de portafolios','Simulación molecular','Ruteo / logística','Optimización de red','Otra / aún no sé'],
  submit:'Solicitar acceso', sending:'Enviando…', ok:'¡Listo! Te contactaremos.', err:'Algo falló. Reintenta o escríbenos.',
  req:'Email válido requerido', close:'Cerrar'
} : {
  title:'Early access', sub:'Tell us the basics and we\'ll reach out when your problem class opens.',
  name:'Name', email:'Email', role:'Role', org:'Company / institution',
  pclass:'Problem class', note:'What are you trying to solve? (optional)',
  roles:['Quant / finance','Computational chemist','Optimization / OR','Research','Other'],
  classes:['Portfolio optimization','Molecular simulation','Routing / logistics','Grid optimization','Other / not sure'],
  submit:'Request access', sending:'Sending…', ok:'Done! We\'ll be in touch.', err:'Something failed. Retry or email us.',
  req:'Valid email required', close:'Close'
};
---
<div class="lead-ov" id="leadModal" aria-hidden="true">
  <div class="lead-box" role="dialog" aria-modal="true" aria-labelledby="leadTitle">
    <button class="lead-x" data-lead-close aria-label={t.close}>✕</button>
    {/* B1.5 · aqui decia "ROSETTA Q", un nombre retirado, servido en produccion.
        El spec pedia cambiarlo por "Early access" — pero el <h3> de la linea
        siguiente YA dice exactamente eso, en los dos idiomas. Poner el mismo
        texto dos veces, uno en versalitas y otro en serif, no es arreglarlo.
        La versalita se retira: el titulo ya esta. (Adelanta la regla del
        bloque 2: como maximo un eyebrow por pagina.) */}
    <h3 id="leadTitle">{t.title}</h3>
    <p class="lead-sub">{t.sub}</p>
    <form id="leadForm" novalidate data-ok={t.ok} data-err={t.err} data-sending={t.sending} data-req={t.req}>
      <input type="hidden" name="lang" value={lang} />
      <div class="lg-row">
        <label>{t.name}<input name="name" type="text" autocomplete="name" /></label>
        <label>{t.email} *<input name="email" type="email" autocomplete="email" required /></label>
      </div>
      <div class="lg-row">
        <label>{t.role}<select name="role">{t.roles.map(r => <option>{r}</option>)}</select></label>
        <label>{t.org}<input name="org" type="text" autocomplete="organization" /></label>
      </div>
      <label>{t.pclass}<select name="problem_class">{t.classes.map(c => <option>{c}</option>)}</select></label>
      <label>{t.note}<textarea name="note" rows="2"></textarea></label>
      <div class="lg-msg" id="leadMsg"></div>
      <button type="submit" class="lg-submit">{t.submit}</button>
    </form>
  </div>
</div>
<style is:global>
/* Portado a la marca el 9-sep. Este modal se abre desde el CTA de TODAS las paginas y
   servia el diseño retirado —fondo negro, eyebrow en dorado, boton en el turquesa viejo
   y en Arial—: el visitante navegaba un sitio crema y teal, apretaba el boton que mas
   importa y se le abria otra empresa. Es el peor sitio posible para una identidad vieja,
   porque es el punto donde se captura un lead.
   Tokens de la marca, y el boton usa el primario del sistema, no uno propio. */
.lead-ov{position:fixed;inset:0;z-index:200;background:rgba(22,24,27,.62);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px}
.lead-ov.open{display:flex}
.lead-box{background:var(--paper);border:1px solid var(--line);border-radius:2px;max-width:520px;width:100%;padding:30px 30px 26px;position:relative;max-height:92vh;overflow:auto}
.lead-x{position:absolute;top:12px;right:14px;background:none;border:none;color:var(--ink-60);font-size:var(--t-body);line-height:1;padding:6px;cursor:pointer}
.lead-x:hover{color:var(--ink)}
.lead-box h3{font-family:var(--serif);font-weight:500;font-size:var(--t-body);line-height:1.18;margin-top:8px;color:var(--ink)}
.lead-sub{color:var(--ink-60);font-size:var(--t-small);margin:8px 0 18px}
#leadForm label{display:block;font-family:var(--mono);font-size:var(--t-data);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-60);margin-bottom:12px}
.lg-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){.lg-row{grid-template-columns:1fr}}
/* B3.3 · 48px de alto y el mismo cuerpo que el texto. Un campo mas bajo que su boton
   se lee como que el formulario esta a medio armar, y a 10px de padding el area
   tactil quedaba por debajo del minimo. El textarea conserva su alto por filas. */
#leadForm input,#leadForm select{width:100%;height:48px;margin-top:6px;background:#FFFFFE;border:1px solid var(--line);border-radius:2px;color:var(--ink);padding:0 12px;font-family:var(--sans);font-size:var(--t-body);text-transform:none;letter-spacing:normal}
#leadForm textarea{width:100%;margin-top:6px;background:#FFFFFE;border:1px solid var(--line);border-radius:2px;color:var(--ink);padding:12px;font-family:var(--sans);font-size:var(--t-body);text-transform:none;letter-spacing:normal}
#leadForm input:focus,#leadForm select:focus,#leadForm textarea:focus{outline:none;border-color:var(--verdict)}
.lg-submit{width:100%;height:48px;background:var(--ink);color:var(--paper);border:1px solid var(--ink);border-radius:2px;padding:0 22px;font-family:var(--sans);font-weight:500;font-size:var(--t-body);cursor:pointer;margin-top:6px}
.lg-submit:hover{background:var(--paper);color:var(--ink)}
.lg-submit:disabled{opacity:.6;cursor:default}
.lg-msg{font-size:var(--t-small);margin-bottom:10px;min-height:0}
.lg-msg.ok{color:var(--verdict)} .lg-msg.err{color:var(--alert)}
</style>
<script is:inline>
(function(){
  var ov=document.getElementById('leadModal'); if(!ov) return;
  function open(e){ if(e)e.preventDefault(); ov.classList.add('open'); ov.setAttribute('aria-hidden','false'); }
  function close(){ ov.classList.remove('open'); ov.setAttribute('aria-hidden','true'); }
  document.querySelectorAll('.nav-cta, [data-lead-open]').forEach(function(b){ b.addEventListener('click', open); });
  ov.addEventListener('click', function(e){ if(e.target===ov) close(); });
  document.querySelectorAll('[data-lead-close]').forEach(function(b){ b.addEventListener('click', close); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
  var f=document.getElementById('leadForm'), msg=document.getElementById('leadMsg');
  f.addEventListener('submit', async function(e){
    e.preventDefault(); msg.className='lg-msg'; msg.textContent='';
    var data=Object.fromEntries(new FormData(f).entries());
    if(!data.email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email)){ msg.className='lg-msg err'; msg.textContent=f.dataset.req; return; }
    var btn=f.querySelector('.lg-submit'); var orig=btn.textContent; btn.disabled=true; btn.textContent=f.dataset.sending;
    try{
      var r=await fetch('/api/lead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
      var j=await r.json();
      if(j.ok){ msg.className='lg-msg ok'; msg.textContent=f.dataset.ok; f.reset(); }
      else { msg.className='lg-msg err'; msg.textContent=f.dataset.err; }
    }catch(err){ msg.className='lg-msg err'; msg.textContent=f.dataset.err; }
    btn.disabled=false; btn.textContent=orig;
  });
})();
</script>
