---
/**
 * «Publicaciones de Rosetta» — la galería de la portada de seguridad (/es/q-ready, /q-ready).
 * Pedido de Nicholas, 23-nov-2026: la tarjeta del informe PQC mensual que iba sola en el hero
 * pasa a ser la primera de una galería, y la guía PQC entra al lado con el mismo formato.
 *
 * UNA LISTA, UN LUGAR. Las tarjetas salen de src/data/publicaciones.json, en su orden. La
 * próxima publicación entra con un registro `tipo: documento` y no toca este archivo. El
 * informe es `tipo: informe-pqc` porque su figura se dibuja del JSON de cada edición.
 *
 * MISMA ALTURA Y MISMA LÍNEA BASE. Cada tarjeta ocupa cuatro filas de la grilla de la galería
 * (etiqueta · título · figura · cuerpo) con `grid-template-rows: subgrid`, así que los títulos,
 * las figuras y el comienzo del cuerpo quedan a la misma altura en todas, y las tarjetas
 * terminan juntas. El CSS está en styles/componentes/publicaciones.css.
 *
 * LOS TEXTOS están APROBADOS (Nicholas, 23-nov-2026: «Sí, así») y se leen del documento sellado
 * (src/data/publicaciones/textos-aprobados/, vía src/lib/textos-galeria.mjs). Aquí no se escribe
 * ninguno: publicaciones.json trae sólo la estructura. Lo vigila scripts/check-textos-galeria.mjs.
 */
import datos from '../../data/publicaciones.json';
import aprobado from '../../data/publicaciones/textos-aprobados/TEXTOS-galeria-seguridad-2026-11-23.md?raw';
import { textosGaleria } from '../../lib/textos-galeria.mjs';
import TarjetaInformePqc from './TarjetaInformePqc.astro';

const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const TX: any = textosGaleria(aprobado);
const G = TX.galeria[es ? 'es' : 'en'];
const TIPOS = new Set(['informe-pqc', 'documento']);
for (const p of datos.publicaciones as any[]) {
  if (!TIPOS.has(p.tipo)) throw new Error(`publicaciones.json: "${p.id}" trae tipo "${p.tipo}", que la galería no sabe pintar`);
  if (p.tipo === 'documento' && !p[lang]) throw new Error(`publicaciones.json: "${p.id}" no trae su estructura en "${lang}"`);
  if (p.tipo === 'documento' && !TX[p.textos]?.[lang]) throw new Error(`publicaciones.json: "${p.id}" pide los textos "${p.textos}", que no están aprobados en "${lang}"`);
}
---
<section class="pub-galeria" aria-labelledby="pub-galeria-t"><div class="wrap">
  <div class="pub-cab">
    <h2 id="pub-galeria-t" class="pub-titulo">{G.titulo}</h2>
    <p class="pub-bajada">{G.bajada}</p>
  </div>
  <div class="pub-grilla">
    {datos.publicaciones.map((p: any) => p.tipo === 'informe-pqc'
      ? <TarjetaInformePqc lang={lang} />
      : (() => {
          const e = p[lang];
          const t = TX[p.textos][lang];
          const idT = `pub-${p.id}-t`;
          return (
            <article class="pub-tarjeta pub-documento" aria-labelledby={idT}>
              <p class="qr-informe-et"><span>{t.etiqueta[0]}</span><span>{t.etiqueta[1]}</span></p>
              <h3 id={idT} class="qr-informe-h">{t.titulo}</h3>
              <figure class="pub-portada">
                <a href={e.enlaces[0]} tabindex="-1" aria-hidden="true">
                  <img src={e.portada.src} width={e.portada.ancho} height={e.portada.alto} alt={t.alt} decoding="async" />
                </a>
              </figure>
              <div class="pub-cuerpo">
                <p class="pub-texto">{t.bajada}</p>
                <p class="pub-meta">{t.meta}</p>
                <p class="pub-acciones">
                  <a class="pub-enlace pub-enlace-principal" href={e.enlaces[0]}>{t.enlaces[0]} <span aria-hidden="true">→</span></a>
                  <a class="pub-enlace" href={e.enlaces[1]}>{t.enlaces[1]}</a>
                </p>
              </div>
            </article>
          );
        })())}
  </div>
</div></section>
