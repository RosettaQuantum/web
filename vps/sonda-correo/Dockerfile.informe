# Imagen del informe PDF (3-nov-2026). Sólo arma PDFs: no abre puertos ni guarda nada.
# docker build -f Dockerfile.informe -t rosetta-informe-pdf .
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir --root-user-action=ignore weasyprint==62.3 pydyf==0.10.0
WORKDIR /w
